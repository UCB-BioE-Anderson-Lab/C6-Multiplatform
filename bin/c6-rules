#!/usr/bin/env node
/**
 * bin/c6-rules — the domain logic, as a table a person can check.
 *
 *     c6-rules              every rule set
 *     c6-rules pcr          one of them
 *     c6-rules --md         markdown, for pasting into a doc
 *
 * **WHY THIS EXISTS.** JCA, 2026-09-13:
 *
 * > *"we are in the details of the domain logic, and the only way to really know for sure we got
 * > it is for me to look at many examples. Alternatively, I try and understand your code and read
 * > it. But you've got a lot of syntax mixed in with the domain logic, that will make it hard to
 * > follow."*
 *
 * Reading a labsheet proves one case. Reading the source proves all of them and costs an hour of
 * filtering `job.program = …` out of the reasoning. This is the third thing: every rule stated as
 * **when · then · why**, in the order they are tried, with nothing else on the page.
 *
 * The table is not a copy of the code — it IS the code, printed. `src/labplanner/rules/*.rules.js`
 * holds the rules as data and the function that applies them does nothing but find the first match,
 * so a table that disagrees with behaviour is impossible rather than merely unlikely.
 */
import fs from 'node:fs';
import { read } from '../src/labplanner/rules/lib.js';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const HERE = path.dirname(fileURLToPath(import.meta.url));
const DIR = path.join(HERE, '..', 'src', 'labplanner', 'rules');
const argv = process.argv.slice(2);
const md = argv.includes('--md');
// **DATA FLOWS OUTWARD, NOT INWARD.** JCA, 2026-09-13: *"You sure you want to put it all in js
// directly like that? Or define a custom schema and file type for a rule list?"*
//
// The predicates are plain comparisons and would sit in a file happily; the outcomes are not —
// three of the four build a sentence by interpolation and one does a lookup plus a template. A
// format that covers both needs an expression language, and an expression language starts at
// `bp < 250` and ends somewhere nobody can read, which is the failure this whole idea exists to
// cure. Worse, splitting prose into a data file and code into a module puts `when` and `applies`
// in different places, and their sitting in ONE object is the only reason the table can be
// trusted.
//
// So JS stays the source and `--json` is the export: C11 can index a rule set, Cortex can read
// one, anything can render one, and there is no parser to keep correct. What it does not buy is a
// rule editable by somebody who does not write JS — which is a real limitation and is written
// down rather than glossed.
const json = argv.includes('--json');
// **WHAT A REVIEWER ASKS FOR FIRST.** A rule's WHY is either something the lab stated or something
// the toolkit's author supplied, and the second is where a plausible-sounding mechanism can sit
// for months looking like knowledge. One did: the reason amp needs no outgrowth was written up as
// a secreted enzyme protecting its neighbours, when it is that a cell thawing out of a heat shock
// is not building wall yet. The rule was right and the reason was invented.
const inferredOnly = argv.includes('--inferred');
const want = argv.filter((a) => !a.startsWith('--'));

const wrap = (s, w, indent) => {
  const out = [];
  let line = '';
  for (const word of String(s).split(/\s+/)) {
    if ((line + ' ' + word).trim().length > w) { out.push(line.trim()); line = ''; }
    line += ' ' + word;
  }
  if (line.trim()) out.push(line.trim());
  return out.map((l, i) => (i ? indent + l : l)).join('\n');
};

const files = fs.existsSync(DIR)
  ? fs.readdirSync(DIR).filter((f) => f.endsWith('.rules.js')).sort()
  : [];
if (!files.length) {
  console.error(`  no rule sets in ${DIR}`);
  process.exit(2);
}

const out = [];
let shown = 0;
for (const f of files) {
  const name = f.replace(/\.rules\.js$/, '');
  if (want.length && !want.some((w) => name.toLowerCase().includes(w.toLowerCase()))) continue;
  shown += 1;
  const m = await import(path.join(DIR, f));
  // **THE WORDS COME FROM THE COMMENTS**, not from fields on the objects. A rule file is plain
  // JavaScript that a person edits; nothing in it exists to feed this printer. → `rules/lib.js`
  const said = read(path.join(DIR, f));
  const title = (m.TITLE || name);
  const wordsFor = (id) => said[id] || {};
  // **WHAT AN EXAMPLE MEANS IS THE RULE SET'S BUSINESS, NOT THIS PRINTER'S.** The first version
  // read every `// eg:` as a product length, because the first rule set's were — so the second
  // one's scenarios came out as `no inventory bp`. A rule set exports `egFacts` to turn its own
  // shorthand into facts; without one, its examples are not printed rather than mangled.
  const factsFor = m.egFacts || null;

  if (json) {
    shown += 1;
    out.push({
      id: name, title,
      facts: (m.FACTS || []).map((x) => ({ name: x.name, ...wordsFor(x.name) })),
      // ORDER IS PART OF THE DOMAIN and an array keeps it. A consumer that sorts these has a
      // different rule set.
      rules: (m.RULES || []).map((r) => ({
        id: r.id, ...wordsFor(r.id),
        // Computed, not written — see the printer below.
        examples: (factsFor ? (wordsFor(r.id).eg || []) : []).map((eg) => {
          const got = m.choose(factsFor(eg));
          return { given: eg, fires: got?.rule === r.id,
                   outcome: got ? { rule: got.rule, chemistry: got.chemistry ?? null,
                                    program: got.program ?? null } : null };
        }),
      })),
    });
    continue;
  }
  if (md) {
    console.log(`## ${title}\n`);
    if (m.FACTS?.length) {
      console.log('**Facts** — read off the job, deciding nothing.\n');
      console.log('| fact | is | when unknown |\n|---|---|---|');
      for (const x of m.FACTS) {
        const w = wordsFor(x.name);
        console.log(`| \`${x.name}\` | ${w.when || ''} | ${w.then || '—'} |`);
      }
      console.log('');
    }
    console.log('**Rules**, in order. The first that applies wins.\n');
    console.log('| when | then | why |\n|---|---|---|');
    for (const r of m.RULES || []) {
      const w = wordsFor(r.id);
      console.log(`| ${w.when} | ${w.then} | ${(w.why || '').replace(/\n\n/g, ' ')} |`);
    }
    console.log('');
    continue;
  }

  if (inferredOnly) {
    const rows = [...(m.FACTS || []), ...(m.RULES || [])]
      .map((x) => [x.id || x.name, wordsFor(x.id || x.name)])
      .filter(([, w]) => /inferred/i.test(w.source || ''));
    if (rows.length) {
      console.log(`\n  ${title}`);
      for (const [id, w] of rows) console.log(`     ${(w.name || id).padEnd(38)} ${w.source}`);
    }
    continue;
  }
  console.log(`\n  ${title}`);
  console.log(`  ${'─'.repeat(Math.max(10, title.length))}`);
  for (const x of m.FACTS || []) {
    const w = wordsFor(x.name);
    console.log(`\n    fact  ${w.name || x.name}`);
    if (w.when) console.log(`          ${wrap(w.when, 84, '          ')}`);
    if (w.then) console.log(`          → ${wrap(w.then, 82, '            ')}`);
  }
  // IN ORDER, AND THE ORDER IS PART OF THE DOMAIN. `long product` sits above `ordinary product`
  // because both apply over 8 kb; printing them unordered would be printing a different rule set.
  for (const [i, r] of (m.RULES || []).entries()) {
    const w = wordsFor(r.id);
    console.log(`\n    ${String(i + 1).padStart(2)}. when  ${wrap(w.when || '', 78, '              ')}`);
    console.log(`        then  ${wrap(w.then || '', 78, '              ')}`);
    // The label goes on the first paragraph only; the rest are indented under it, because a
    // reason that runs to two paragraphs is one reason.
    for (const [j, para] of String(w.why || '').split('\n\n').entries()) {
      console.log(`        ${j ? '      ' : 'why   '}${wrap(para, 78, '              ')}`);
      if (j < String(w.why || '').split('\n\n').length - 1) console.log('');
    }
    // **WORKED EXAMPLES, COMPUTED BY RUNNING THE RULES.** `when` is prose beside the predicate and
    // could drift from it — `<` quietly becoming `<=` leaves the sentence reading the same. These
    // lines are `choose()` output, so the table shows what the code does at each boundary rather
    // than what its sentence claims. A rule that turns out not to fire for its own example says so.
    if (w.source) console.log(`        from  ${wrap(w.source, 78, '              ')}`);
    for (const eg of (factsFor ? wordsFor(r.id).eg || [] : [])) {
      const got = m.choose(factsFor(eg));
      const input = String(eg);
      // WHATEVER THE RULE DECIDED, not a fixed pair of fields. This printed
      // `no chemistry, program none` for a rule set that has neither, because the first rule set
      // it was written against had both.
      // A DELIBERATE NULL IS AN ANSWER. `{ program: null }` means "no program, and that is the
      // decision" — dropping it printed "decides nothing of its own" about a rule whose whole job
      // is to decide that.
      const decided = got && Object.entries(got)
        .filter(([k, v]) => k !== 'rule' && k !== 'note' && v !== undefined
                         && (v === null || typeof v !== 'object'))
        .map(([k, v]) => (v === null ? `no ${k}` : `${k} ${v}`)).join(', ');
      const outcome = !got ? 'nothing decides it'
        : got.rule !== r.id ? `falls through to "${wordsFor(got.rule).name || got.rule}"`
        : (decided || 'decides nothing of its own');
      console.log(`        e.g.  ${input.padEnd(22)} ${outcome}`);
    }
  }
  console.log('');
}
if (json) console.log(JSON.stringify(out, null, 2));
if (!shown) {
  console.error(`  nothing matched. Rule sets: ${files.map((f) => f.replace(/\.rules\.js$/, '')).join(', ')}`);
  process.exit(1);
}
