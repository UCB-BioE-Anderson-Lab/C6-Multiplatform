#!/usr/bin/env node
/**
 * Plan -> LabPacket. The join between `c6-plan` and `labpacket-to-xlsx.py`.
 *
 *     c6-packet <project-dir> [--inventory <file>] > packet.json
 *
 * **This existed nowhere.** `c6-plan` answers which labsheets there are and what is on each;
 * `labpacket-to-xlsx.py` renders a LabPacket into the sheet a student carries. They were written
 * against each other's ideas and never connected: `jobsToLabSheets.js` is an empty module, and
 * `generateLabPacket` checks for it, finds nothing, and returns an EMPTY PACKET without saying
 * so. The gap only shows when somebody asks for the actual file.
 *
 * **One operation per sheet, one sheet per session.** The planner's bins are already that —
 * `binReactions` groups what may share a sheet — so this is a projection, not a second planner.
 * Where a session should hold more than one operation, that is `operations/sessions.md`'s
 * business and a person's decision, not this file's.
 *
 * **Protocols are transcluded, never copied.** Each operation names a module and the renderer
 * pulls the text at render time, so a labsheet cannot carry a stale fork of a protocol the way
 * the old workbooks did — the Gel tab had lost "LOAD must be fresh" and nobody could tell.
 *
 * **A PROJECTION THAT IS THE SAME FOR EVERY OPERATION IS NOT A PROJECTION.** The first version
 * emitted one table — label, from, size, program — for all nine sheets, so the PCR sheet and the
 * Gel sheet were the same page twice, and the PCR named neither its oligos nor its recipe. JCA,
 * 2026-09-12, looking at it: *"there are no oligos or recipe in that pcr. It has like none of the
 * critical info, and is identical to the gel."*
 *
 * The plan had all of it. `samples[].oligos`, `samples[].params` and `sheets[].mastermix` were
 * computed correctly and thrown away here — and `mastermix` was handed to the renderer under a
 * key it does not read, so `reaction_block` never fired once. **A labsheet's whole job is the
 * part nobody can look up**: the protocol is on a cheatsheet, the primer pair is not.
 *
 * So each operation says what its own columns are. The rule for what belongs: everything the
 * cheatsheet cannot tell you, and nothing it can.
 */
import fs from 'node:fs';
import path from 'node:path';
import { execFileSync } from 'node:child_process';

const argv = process.argv.slice(2);
const dir = argv.find((a) => !a.startsWith('--') && argv[argv.indexOf(a) - 1] !== '--inventory');
if (!dir) { console.error('  c6-packet: give a project directory'); process.exit(2); }
const invIdx = argv.indexOf('--inventory');

// The protocol module each operation is performed by. An operation with no module renders its
// own content and says nothing false; a WRONG module would put another procedure on the page.
const MODULE = {
  pcr: 'primestar_pcr', gel: 'analytical_gel', zymo: 'zymo_cleanup',
  goldengate: 'golden_gate_assembly', transform: 'heat_shock_transformation',
  miniprep: 'qiagen_miniprep', sequencing: 'cycle_sequencing',
  pick: 'picking_colonies_into_block', assay: 'plate_reader_fluorescence',
};

const TITLE = {
  pcr: 'PCR', gel: 'Gel', zymo: 'Cleanup', goldengate: 'Golden Gate assembly',
  transform: 'Transformation', retransform: 'Electroporation', pick: 'Picking colonies',
  culture: 'Culture', assay: 'Assay', dilution: 'Oligo dilutions',
};

const planArgs = [path.join(path.dirname(new URL(import.meta.url).pathname), 'c6-plan'), dir, '--json'];
if (invIdx >= 0) planArgs.push('--inventory', argv[invIdx + 1]);
const plan = JSON.parse(execFileSync('node', planArgs, { encoding: 'utf8', maxBuffer: 64e6 }));

const experiment = path.basename(dir);

const bp = (x) => (x.productBp ? `${x.productBp} bp` : '');
const joined = (x) => (x.inputs || []).join(', ');

// THE LABEL IS NOT THE PRODUCT NAME, and emitting the product name as the label is what made
// every sheet warn. `Pcon-amilGFP-Term` is a fine name for the record and hopeless on a cap;
// the tube gets a short unique one and the two live side by side in their own columns.
//
// The numbering is the protocol's own: `primestar_pcr` tells the student *"the top label is the
// number from your labsheet for that reaction (pcr_1 … pcr_n)"*, which only works if the
// labsheet actually carries that number. It did not.
const PREFIX = { pcr: 'pcr', zymo: 'z', goldengate: 'gg', transform: 't', retransform: 'et',
                 pick: 'p', culture: 'c', assay: 'a' };
const tubeOf = (op, i, n) => (n === 1 ? `${PREFIX[op] || op.slice(0, 2)}` 
                                      : `${PREFIX[op] || op.slice(0, 2)}${i + 1}`);

// WHAT EACH OPERATION'S TABLE SAYS. One function per operation, returning an ordered object —
// the renderer builds its header from the first row's keys, so every row of a sheet must carry
// the same ones, which is why these return fixed shapes with blanks rather than omitting keys.
const COLUMNS = {
  pcr: (x, t) => ({
    tube: t,
    product: x.output,
    'forward oligo': (x.oligos || [])[0] || '',
    'reverse oligo': (x.oligos || [])[1] || '',
    template: joined(x),
    'expected size': bp(x),
    program: x.program || '',
  }),
  // The gel checks that a band formed at the right size. The sizes are the sheet.
  gel: (x) => ({ 'PCR product': x.output, 'expected size': bp(x) }),
  // Cleanup keeps the size because it sets the elution: a 6.5 kb product does not come off the
  // column like a 1.4 kb one.
  zymo: (x, t) => ({ tube: t, 'PCR product': x.output, size: bp(x) }),
  goldengate: (x, t) => ({
    tube: t,
    product: x.output,
    fragments: (x.inputs || []).join('  +  '),
    enzyme: (x.params || {}).enzyme || '',
  }),
  transform: (x, t) => ({
    plate: t,
    product: x.output,
    DNA: joined(x),
    strain: (x.params || {}).strain || '',
    antibiotic: (x.params || {}).antibiotics || (x.params || {}).antibiotic || '',
    temperature: (x.params || {}).temperature || '',
  }),
  retransform: (x, t) => ({
    plate: t,
    product: x.output,
    DNA: joined(x),
    host: (x.params || {}).host || (x.params || {}).strain || '',
    antibiotic: (x.params || {}).antibiotic || (x.params || {}).antibiotics || '',
    temperature: (x.params || {}).temp || (x.params || {}).temperature || '',
    method: (x.params || {}).method || '',
  }),
  pick: (x, t) => ({ block: t, product: x.output, 'from plate': joined(x),
                  'colonies to pick': (x.params || {}).n || '' }),
  culture: (x, t) => ({ block: t, product: x.output, from: joined(x),
                     medium: (x.params || {}).medium || '',
                     vessel: (x.params || {}).vessel || '',
                     volume: (x.params || {}).volume || '' }),
  assay: (x) => ({ product: x.output, samples: joined(x) }),
};

const DEFAULT_COLUMNS = (x, t) => ({
  label: t, product: x.output, from: joined(x),
  ...(x.productBp ? { size: bp(x) } : {}),
  ...(x.program ? { program: x.program } : {}),
});

// A parameter already standing in its own column is not repeated under "For this experiment".
// Two statements of the same temperature on one page is one of them being wrong later.
const SHOWN_AS_COLUMN = {
  goldengate: ['enzyme'],
  transform: ['strain', 'antibiotic', 'antibiotics', 'temperature'],
  retransform: ['host', 'strain', 'antibiotic', 'antibiotics', 'temp', 'temperature', 'method'],
  pick: ['n'],
  culture: ['medium', 'vessel', 'volume'],
};

// THE RECIPE, FROM THE PLANNER'S OWN ARITHMETIC. `makeMastermixPlan` has already done the set
// arithmetic over the bin — which components every tube shares and which differ — and the
// renderer's `reaction_block` re-derives the same split from each component's `varies`. So the
// planner's decision is carried across in that field: a component it found shared arrives with
// `varies: null` whether or not the generic recipe says it can vary.
function recipeOf(s) {
  const mm = s.mastermix;
  if (!mm) return null;
  const comp = (c, varies) => ({ name: c.label, amount: c.uL,
                                 varies: varies === undefined ? (c.varies || null) : varies });
  const components = mm.mastermix
    ? [...(mm.shared || []).map((c) => comp(c, null)), ...(mm.perTube || []).map((c) => comp(c))]
    : (mm.perReaction || []).map((c) => comp(c));
  if (!components.length) return null;
  return { operation: s.operation, components };
}

// WHAT THE PROTOCOL MODULE IS BEING ASKED TO SAY. A module rendered with its defaults is worse
// than one not rendered: `primestar_pcr` with none reads "Set up 1 × 50 µL PCR with
// forward_oligo/reverse_oligo on template_dna", which is a sentence about no experiment at all,
// printed in the one place a student looks first.
//
// A NAME IS PASSED ONLY WHERE EVERY SAMPLE AGREES ON IT. Two PCRs with different primer pairs
// have no forward oligo, and naming either one would be a specific claim about both.
const only = (xs) => (new Set(xs.filter(Boolean)).size === 1 ? xs.find(Boolean) : null);

function protocolValues(op, mod, samples, mm, producer) {
  const n = samples.length || 1;
  const p = (x) => x.params || {};
  const first = samples[0] || {};
  // The conditions of whatever made this step's input. A pick does not say which antibiotic the
  // block's medium carries; the plate it picks from does, and that is a derivation over the plan
  // rather than a guess. Without it `picking_colonies_into_block` prints its default, "carb",
  // onto a sheet about Lactococcus on erythromycin.
  const up = (x) => producer((x.inputs || [])[0]) || {};

  if (mod === 'primestar_pcr' || mod === 'taq_pcr') {
    const f = only(samples.map((x) => (x.oligos || [])[0]));
    const r = only(samples.map((x) => (x.oligos || [])[1]));
    const t = only(samples.map((x) => (x.inputs || [])[0]));
    return { [mod]: {
      reactions: n,
      ...(mm ? { use_mastermix: !!mm.mastermix } : {}),
      per_sample: !(f && r && t),
      ...(f ? { primer1_name: f } : {}),
      ...(r ? { primer2_name: r } : {}),
      ...(t ? { template_name: t } : {}),
    } };
  }
  if (mod === 'analytical_gel') return { [mod]: { samples: n } };
  if (mod === 'zymo_cleanup') return { [mod]: { reactions: n } };
  if (mod === 'golden_gate_assembly') {
    return { [mod]: { reactions: n,
                      fragments: Math.max(...samples.map((x) => (x.inputs || []).length), 1),
                      ...(p(first).enzyme ? { enzyme: p(first).enzyme } : {}) } };
  }
  if (mod === 'heat_shock_transformation') {
    const a = p(first);
    return { [mod]: {
      plasmid: (first.inputs || [])[0] || '',
      ...(a.strain ? { host: a.strain } : {}),
      ...(a.antibiotics || a.antibiotic ? { antibiotics: a.antibiotics || a.antibiotic } : {}),
      ...(a.temperature ? { temperature_C: Number(a.temperature) } : {}),
      product_name: first.output || '',
    } };
  }
  if (mod === 'picking_colonies_into_block') {
    const a = p(first);
    const abx = up(first).antibiotic || up(first).antibiotics;
    return { [mod]: {
      samples: (first.inputs || []).length || 1,
      ...(a.n ? { colonies_per_sample: Number(a.n) } : {}),
      ...(abx ? { antibiotic: abx } : {}),
    } };
  }
  if (mod === 'plate_reader_fluorescence') {
    const a = p(first);
    return { [mod]: {
      samples: culturesOf(first, producer),
      ...(a.replicates ? { technical_replicates: Number(a.replicates) } : {}),
    } };
  }
  return {};
}

// HOW MANY CULTURES THERE ACTUALLY ARE. The assay reads a block, and the block holds the picked
// clones plus whatever the culture step inoculates alongside them — `inoculate=` names the
// controls, which are grown from a restreak rather than picked. Read off the plan rather than
// defaulted: `plate_reader_fluorescence` defaults to 24 cultures, and an assay sheet that opens
// "Read 24 cultures" about six of them is wrong in its first sentence and in every number after.
//
// THIS IS ARITHMETIC THE PLANNER SHOULD OWN. A `culture` job knows its own well count better than
// a projection does; doing it here keeps the sheet honest today and is the thing to move when
// `culture` grows a `wells` field.
function culturesOf(assay, producer) {
  const cult = producer((assay.inputs || [])[0]) || {};
  const controls = String(cult.inoculate || '').split(',').map((t) => t.trim()).filter(Boolean);
  const pick = producer(cult._from) || {};
  const clones = Number(pick.n || 0);
  return (clones + controls.length) || undefined;
}

// Every step by the name of what it produces, so a sheet can read the conditions of the step
// upstream of it. The plan already carries the edges; this is an index over them.
const BY_OUTPUT = new Map();
for (const s of plan.sheets || []) {
  for (const x of s.samples || []) {
    BY_OUTPUT.set(x.output, { ...(x.params || {}), _from: (x.inputs || [])[0] });
  }
}
const producer = (name) => (name ? BY_OUTPUT.get(name) : undefined);

const sheets = (plan.sheets || []).map((s) => {
  const op = String(s.operation || '').toLowerCase();
  const samples = s.samples || [];
  const params = samples.reduce((a, x) => ({ ...a, ...(x.params || {}) }), {});
  // THE PLANNER'S CHOICE BEATS THE TABLE. For a PCR the module follows the chemistry, which is
  // decided from the product size — so when nothing simulated, the planner names no module and
  // this must not name one either. `MODULE.pcr` is the fallback for the ordinary case, not a
  // second opinion about a case the planner refused.
  const mod = params.protocol
            || (op === 'pcr' && 'protocolModule' in s ? s.protocolModule : MODULE[op])
            || null;
  const blocks = [];
  if (mod) blocks.push({ kind: 'text', text: `{${mod}}` });

  // The step's own conditions, minus anything already in the table. These are what the file said
  // and the renderer has no other way to know them — the protocol is generic, the temperature is
  // not.
  const hidden = new Set([...(SHOWN_AS_COLUMN[op] || []), 'protocol']);
  const shown = Object.entries(params).filter(([k]) => !hidden.has(k));
  if (shown.length) {
    blocks.push({ kind: 'heading', text: 'For this experiment' });
    blocks.push({ kind: 'table', rows: [['', ''], ...shown.map(([k, v]) => [k, v])] });
  }

  const cols = COLUMNS[op] || DEFAULT_COLUMNS;
  const notes = [];
  // `reaction_block` already says "2 samples — set the reaction up directly" for the
  // sub-threshold case, so the planner's `why` would be the same sentence twice. Where there IS
  // a mastermix it says which components are shared, which nothing else on the page does.
  if (s.mastermix && s.mastermix.mastermix && s.mastermix.why) notes.push(s.mastermix.why);
  for (const x of samples) if (x.note) notes.push(`${x.output}: ${x.note}`);
  // A HOLE IS SHOWN, NOT LEFT BLANK. Without a chemistry there is no recipe to print, and a
  // labsheet that simply omits the reaction looks finished.
  for (const u of s.unresolved || [])
    notes.push(`No reaction is written for ${u.output}: ${u.why}. The chemistry follows the `
             + `product size, so nothing here says which buffer and which volumes to use.`);

  return {
    id: `${op}${s.round ? `-${s.round}` : ''}`,
    title: `${TITLE[op] || op} for Experiment ${experiment}`,
    operation: TITLE[op] || op,
    metadata: { experiment, ...(mod ? { module: mod } : {}) },
    inputs: [], outputs: [], notes,
    recipe: recipeOf(s),
    samples: samples.map((x, i) => cols(x, tubeOf(op, i, samples.length))),
    blocks,
    ...(mod ? { protocol_values: protocolValues(op, mod, samples, s.mastermix, producer) } : {}),
  };
});

process.stdout.write(JSON.stringify({
  id: experiment,
  metadata: { title: `LabSheets — ${experiment}`, experiment,
              source: `planned from ${(plan.files || []).length} file(s) by c6-packet` },
  sheets,
  ...(plan.problems && plan.problems.length ? { problems: plan.problems } : {}),
}, null, 2));
