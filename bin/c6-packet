#!/usr/bin/env node
/**
 * Plan -> LabPacket, on the command line.
 *
 *     c6-packet <project-dir> [--inventory <file>] > packet.json
 *
 * **THE WORK IS NOT HERE.** It is in `planning/jobsToLabSheets.js`, which is the planner's last
 * stage and was `export {}` until 2026-09-13. This file did that stage's job inline for a day,
 * which is how the pipeline came to have two spines: `C6-LabPlanner.generateLabPacket` guarded
 * every stage behind `typeof X === 'function'`, found no `jobsToLabSheets`, and returned an empty
 * packet without saying so, while the thing that actually produced sheets was a bin script.
 *
 * What is left here is a command line: read the flags, run `c6-plan`, hand the plan to the stage,
 * print the packet, and put the stage's findings on stderr where somebody watching a run sees them.
 */
import path from 'node:path';
import { execFileSync } from 'node:child_process';
import fs from 'node:fs';
import { jobsToLabSheets } from '../src/labplanner/planning/jobsToLabSheets.js';
import { FATAL } from '../src/labplanner/planning/planExperiment.js';

const argv = process.argv.slice(2);
// FLAGS THAT TAKE A VALUE, AS A SET. The directory used to be "the first argument that is not a
// flag and does not follow --inventory", which read `--control-stocks <file>`'s value as the
// project: `commonAncestor` climbed to $HOME and `projectSequences` walked Dropbox and never
// returned. A list of flags that take values is the only way this stays right as flags are added.
const VALUED = new Set(['--inventory', '--control-stocks', '--sequence', '--label-prefix',
                        '--answers', '--phase', '--only']);
const dir = argv.find((a, i) => !a.startsWith('--') && !VALUED.has(argv[i - 1]));
if (!dir) { console.error('  c6-packet: give a project directory'); process.exit(2); }
const flag = (n) => { const i = argv.indexOf(n); return i >= 0 ? argv[i + 1] : null; };

// `--only <products>` NAMES THE CONSTRUCTS THIS WORKBOOK IS FOR, and is how six students get six
// different books out of one experiment folder. `c6-plan` has always accepted individual files as
// well as a directory, so this needs no new reading path: it resolves the products to their two
// files each and passes those instead of the folder.
//
// **A NAME THAT MATCHES NOTHING IS A STOP, NOT AN EMPTY BOOK.** A typo in a student's construct
// would otherwise compile a workbook with nothing in it, which is the one output nobody reads
// closely enough to notice is wrong.
const only = flag('--only');
let planTargets = [dir];
if (only) {
  const want = only.split(',').map((x) => x.trim()).filter(Boolean);
  const present = fs.readdirSync(dir);
  const missing = [];
  planTargets = [];
  for (const p of want) {
    const hits = present.filter((f) =>
      new RegExp(`^(construction|characteri[sz]ation) of ${p.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}\\.txt$`, 'i').test(f));
    if (!hits.some((f) => /^construction/i.test(f))) missing.push(p);
    planTargets.push(...hits.map((f) => path.join(dir, f)));
  }
  if (missing.length) {
    console.error(`  c6-packet: --only names ${missing.join(', ')}, and there is no `
                + `"Construction of <that>.txt" in ${path.basename(dir)}.`);
    console.error('  Constructs present: ' + present.filter((f) => /^construction of /i.test(f))
      .map((f) => f.replace(/^construction of /i, '').replace(/\.txt$/i, '')).join(', '));
    process.exit(2);
  }
}
const planArgs = [path.join(path.dirname(new URL(import.meta.url).pathname), 'c6-plan'),
                  ...planTargets, '--json'];
for (const f of ['--inventory', '--control-stocks']) if (flag(f)) planArgs.push(f, flag(f));
for (const f of ['--clone-only']) if (argv.includes(f)) planArgs.push(f);

// A PLAN WITH FINDINGS IS STILL A PLAN. `c6-plan` exits 1 whenever `problems` is non-empty, which
// is a useful signal to a person and to CI — and it made `execFileSync` throw, so a single finding
// took the whole compile down and printed a stack trace instead of the finding. The problems are
// carried on the packet; the exit code is a summary of them, not a refusal to hand them over.
const plan = (() => {
  try {
    return JSON.parse(execFileSync('node', planArgs, { encoding: 'utf8', maxBuffer: 64e6 }));
  } catch (e) {
    const out = e.stdout && String(e.stdout);
    if (out) { try { return JSON.parse(out); } catch { /* not a plan at all */ } }
    console.error(`  c6-packet: c6-plan failed\n${String(e.stderr || e.message).trim()}`);
    process.exit(2);
  }
})();

const experiment = path.basename(dir);

// ANSWERS TO THE DECLARED DECISIONS — `src/labplanner/planning/decisions/`. The compile never asks
// anybody anything; it reads what was answered out of band, so a rebuild produces the same labels
// as the build before it. `bin/c6-decide` prints what is still open.
//
// `--label-prefix` is the same thing said on the command line, and is kept because typing one is
// faster than writing a file for it.
const answers = (() => {
  const f = flag('--answers');
  if (!f) return {};
  try { return JSON.parse(fs.readFileSync(f, 'utf8')); }
  catch (e) { console.error(`  c6-packet: could not read ${f}: ${e.message}`); process.exit(2); }
})();
if (flag('--label-prefix')) answers.labelPrefix = flag('--label-prefix');

let out;
try {
  const phase = flag('--phase') ? Number(flag('--phase')) : null;
  if (phase !== null && !Number.isInteger(phase)) {
    console.error(`  c6-packet: --phase takes a whole number, not ${JSON.stringify(flag('--phase'))}`);
    process.exit(2);
  }
  out = jobsToLabSheets(plan, { experiment, answers, sequenceId: flag('--sequence'), phase });
} catch (e) {
  // THE MODEL THROWS AND THE MESSAGE IS THE FINDING. `addSample` refuses a duplicate label, a row
  // that does not match the declared columns, and a label too long for what it is written on —
  // each of which used to reach paper. Printing the message alone, rather than a stack, is what
  // makes it readable to the person who has to fix the design.
  console.error(`  c6-packet: ${e.message}`);
  process.exit(2);
}

// **EVERY PROBLEM IS SAID OUT LOUD, not only carried in the JSON.** This printed only the format
// refusals, so a construction file with two PCRs both producing `frag` compiled into eleven
// printable labsheets, exit 0, with `DUPLICATE_PRODUCT` sitting in the packet and mentioned
// nowhere. A sheet saying "fetch frag" names two different tubes and somebody picks one.
for (const p of plan.problems || []) {
  const fatal = FATAL.has(p.code);
  console.error(`  ${fatal ? '✗' : '!'} ${p.code}  ${p.cf || ''}${p.line ? `:${p.line}` : ''}  `
              + `${p.message || p.output || ''}`);
}

// A PACKET WITH AN AMBIGUOUS REFERENCE IN IT IS NOT HANDED OVER. The others are reported and the
// sheets still stand: a dangling product is a step doing work nothing needs, and every sheet is
// still true. → `planning/planExperiment.js § FATAL`
const fatal = (plan.problems || []).filter((p) => FATAL.has(p.code));
if (fatal.length) {
  console.error(`\n  c6-packet: ${fatal.length} problem(s) make these labsheets untrustworthy, `
              + 'so none was written.\n  Fix the construction file — `c6-check` explains each — '
              + 'and compile again.');
  process.exit(2);
}
for (const w of out.warnings) console.error(`  ! ${w}`);

// **AN EMPTY PACKET IS NOT A PACKET, AND MUST NOT BE HANDED OVER AS ONE.** With every file in a
// dialect this reader does not speak, the planner correctly makes nothing — and this used to print
// a well-formed packet with no sheets, claiming in its own metadata to have been "planned from 3
// file(s)", and exit 0. A caller that checks the exit code and renders the result gets an empty
// workbook and no reason.
if (!out.sheets.length) {
  console.error('\n  c6-packet: no labsheets were made.');
  for (const p of plan.problems || []) console.error(`     ${p.code}  ${p.cf}  ${p.message || ''}`);
  if (!(plan.problems || []).length) {
    console.error('     Nothing in this project produced a step. Is there a construction file?');
  }
  process.exit(2);
}

process.stdout.write(JSON.stringify({
  id: experiment,
  metadata: { title: `LabSheets — ${experiment}`, experiment,
              // WHAT WAS READ, not what was found. A file the planner refused is not a file this
              // packet was planned from, and saying otherwise overstates what is on the page.
              source: `planned by c6-packet from ${(plan.files || []).length
                        - (plan.problems || []).filter((p) => /FORMAT$/.test(p.code)).length}`
                    + ` of ${(plan.files || []).length} file(s)` },
  sheets: out.sheets,
  ...(plan.problems && plan.problems.length ? { problems: plan.problems } : {}),
}, null, 2));
