#!/usr/bin/env node
/**
 * c6-labplan — construction files + a characterization file + an inventory, in; a workbook out.
 *
 *     c6-labplan <experiment-dir> --inventory <file> --out <file.xlsx> --collector <address>
 *     c6-labplan <dir> --only pBET8,pBET10 --phase 1 --label-prefix W   one student's phase 1
 *
 * **`--only` AND `--phase` ARE ABOUT SCOPE OF ISSUE, NOT ABOUT THE EXPERIMENT.** Six students
 * building four constructs between them get six workbooks out of one folder; the plasmid work is
 * individual and the host work is shared, so phase 1 is issued six ways and phase 2 once.
 *
 * JCA, 2026-09-12: *"we should build these cheese lab sheets through the automated workflow
 * starting from the construction files… you pass it the construction and characterization files
 * and inventory, and it automates the rest. You would work with the user to define the
 * characterization sequence, lock that down in a file, then compile."*
 *
 * **THE TWO HALVES OF THAT SENTENCE ARE DIFFERENT KINDS OF WORK, AND THIS COMMAND IS ONLY THE
 * SECOND.** Deciding what the experiment does — what gets retransformed into what, on which
 * antibiotic, read how — is a conversation, and its output is a file somebody can read and argue
 * with. Compiling that file into labsheets is deterministic and should never ask anybody
 * anything. Keeping them apart is what makes the compile trustworthy: everything on a labsheet
 * traces to a line in a file, and nothing to a choice made at render time.
 *
 * **So a missing characterization file is not a missing input. It is a conversation that has not
 * happened yet**, and this stops rather than compiling half an experiment and letting the gap
 * show up as a packet that ends at the transformation. `--clone-only` is how you say the
 * experiment really does end at a verified plasmid.
 *
 * It runs `c6-plan`, `c6-packet` and `labpacket-to-xlsx.py` in order, which is what everybody was
 * doing by hand. Nothing here decides content — see `src/labplanner/design/`.
 *
 * **`--packet-out <file>` STOPS AT THE PACKET, and that is the seam a lab injects at.** JCA,
 * 2026-09-12: *"what belongs in C6 would be the generalized one that compiles cf and
 * characterization f to a labsheet... After that comes lab specific information injection by
 * cortex."* Checkpoints, a routing slug, a collecting address, which box is the training box —
 * none of that is this toolkit's, and none of it needs to be, because the packet is JSON and a
 * lab can add to it before asking for the workbook.
 */
import fs from 'node:fs';
import path from 'node:path';
import { execFileSync } from 'node:child_process';
import { isCharacterizationFile } from '../src/labplanner/validate/characterizationFile.js';
import { detectDialect } from '../src/labplanner/validate/constructionFile.js';

const HERE = path.dirname(new URL(import.meta.url).pathname);
const argv = process.argv.slice(2);
const flag = (name) => { const i = argv.indexOf(name); return i >= 0 ? argv[i + 1] : null; };
const has = (name) => argv.includes(name);

// FLAGS THAT TAKE A VALUE, AS A SET. This used to be "the first argument that is not a flag and
// does not follow one", which treats a bare switch like `--json` as consuming the next argument and
// depends on `indexOf` finding the right occurrence of a repeated value. The same shape of guess in
// `c6-packet` read `--control-stocks <file>`'s value as the project directory, and the run walked
// Dropbox and never returned.
const VALUED = new Set(['--inventory', '--out', '--packet-out', '--collector', '--sequence',
                        '--control-stocks', '--answers', '--label-prefix', '--record-tab',
                        '--slug-prefix', '--sequencing-url', '--phase', '--only']);
const dir = argv.find((a, i) => !a.startsWith('--') && !VALUED.has(argv[i - 1]));
if (!dir) {
  // THE USAGE LINE A CALLER ACTUALLY SEES, which is the worse of the two places to be missing a
  // flag — the docstring above is read by somebody opening the file, this by somebody who has just
  // got it wrong. `--only` and `--phase` were in the first and not the second.
  console.error('  c6-labplan <experiment-dir> --inventory <f> --out <f.xlsx> --collector <address>'
              + '\n                             [--only <products>] [--phase <n>] [--clone-only]');
  process.exit(2);
}
const packetOut = flag('--packet-out');
const out = flag('--out') || path.join(dir, `${path.basename(dir)}-labsheets.xlsx`);
const collector = flag('--collector');
const inventory = flag('--inventory');

// ---- the gate ----------------------------------------------------------------------------
// **A DIRECTORY THAT IS NOT THERE IS A TYPO, NOT A CRASH.** Every other command in `bin/` says a
// sentence — `c6-check: no such path`, `c6-plan: no construction files found` — and this one went
// straight into `node:fs:1521 const result = binding.readdir(`, which is the failure `CLAUDE.md`
// names in as many words: *never a stack trace over the top of the sentence that would have
// helped.* Found 2026-09-16 while checking that a good experiment still compiles, by mistyping the
// path of one that did.
if (!fs.existsSync(dir)) {
  console.error(`  c6-labplan: no such directory: ${dir}`);
  process.exit(2);
}
if (!fs.statSync(dir).isDirectory()) {
  console.error(`  c6-labplan: ${dir} is a file. This takes the experiment's FOLDER — the one `
              + 'holding "Construction of <product>.txt" and the inventory.');
  process.exit(2);
}
const files = fs.readdirSync(dir);
const construction = files.filter((f) => /^construction of .*\.txt$/i.test(f));
const characterization = files.filter((f) => isCharacterizationFile(f));

if (!construction.length) {
  console.error(`  c6-labplan: no construction file in ${dir}. `
              + `Expected "Construction of <product>.txt".`);
  process.exit(2);
}

// WHICH CONSTRUCTS HAVE HAD THE CONVERSATION. Matched on the product name in the filename, which
// is the only link the two documents have — a characterization file is "what happens to X once it
// is built" and names X in its title exactly as the construction file does.
const productOf = (f) => f.replace(/^(construction|characterization) of /i, '').replace(/\.txt$/i, '');
const characterized = new Set(characterization.map(productOf));
// THE GATE ASKS ABOUT THE CONSTRUCTS BEING COMPILED, not about every file in the folder. With
// `--only pBET8`, an uncharacterised pBET11 sitting in the same directory is somebody else's
// problem and not a reason to refuse this student's workbook.
const wanted = flag('--only')
  ? new Set(flag('--only').split(',').map((x) => x.trim()).filter(Boolean))
  : null;
const inScope = (p) => !wanted || wanted.has(p);
const uncharacterized = construction.map(productOf)
  .filter((p) => inScope(p) && !characterized.has(p));

console.error(`  ${construction.length} construction file(s), `
            + `${characterization.length} characterization file(s) in ${path.basename(dir)}`);

// **AN UNREADABLE CONSTRUCTION FILE COMES FIRST.** Run on Pimar's Tlib3 — seven files in the
// legacy parenthetical dialect — this printed *"STOP: no characterization file for pTlib3,
// pTlib3A, …"* and seven paragraphs telling somebody to write seven new files, and never once
// mentioned that not one of the construction files had been read. You cannot say what a plasmid
// is FOR when nothing knows how it is built; writing the seven characterization files first would
// have been an afternoon spent before meeting the actual problem.
//
// The dialect is detected here rather than being left to `planExperiment`, because this gate runs
// before the planner does and a gate that asks for the wrong thing first is worse than no gate.
const unreadable = construction.filter((f) => {
  try { return detectDialect(fs.readFileSync(path.join(dir, f), 'utf8')) === 'legacy'; }
  catch { return false; }   // absence-ok: an unreadable file is the planner's problem to name
});
if (unreadable.length) {
  console.error('');
  console.error(`  STOP — ${unreadable.length} construction file(s) are in the legacy `
              + 'parenthetical style and were not read:');
  for (const f of unreadable) console.error(`     ${f}`);
  console.error('');
  console.error('  That style — `PCR a/b on TEMPLATE     (product)` — predates the format this');
  console.error('  planner implements. It is not a defect in the files; they are older than the');
  console.error('  standard. `c6-check <dir>` prints the detail.');
  console.error('');
  console.error('  Nothing downstream of this can be right, so the characterization gate is not');
  console.error('  even reached: what a plasmid is FOR is not a question worth asking about a');
  console.error('  construction nobody has read.');
  process.exit(3);
}

if (uncharacterized.length && !has('--clone-only')) {
  console.error('');
  console.error(`  STOP — no characterization file for: ${uncharacterized.join(', ')}`);
  console.error('');
  console.error('  A construction file says how to build the plasmid. It says nothing about what');
  console.error('  the plasmid is FOR, and that is not something this compiler may invent: which');
  console.error('  host, which antibiotic, which controls, which reporter, read at what');
  console.error('  wavelengths. Those are decisions, and the place they belong is a file somebody');
  console.error('  can read and argue with.');
  console.error('');
  for (const p of uncharacterized) {
    console.error(`  Write ${dir}/Characterization of ${p}.txt — one operation per line, subject`);
    console.error('  first, product last, key=value for the rest. Operations: retransform,');
    console.error('  culture, pick, assay. Nothing in it changes the DNA.');
  }
  console.error('');
  console.error('  Or pass --clone-only if the experiment really does end at a verified plasmid.');
  process.exit(3);
}

// ---- compile -----------------------------------------------------------------------------
const packetArgs = [path.join(HERE, 'c6-packet'), dir];
if (inventory) packetArgs.push('--inventory', inventory);
if (flag('--sequence')) packetArgs.push('--sequence', flag('--sequence'));
if (flag('--control-stocks')) packetArgs.push('--control-stocks', flag('--control-stocks'));
// ANSWERS TO THE DECLARED DECISIONS. `bin/c6-decide` prints what is open; passing the file back
// makes the compile deterministic. Without it each decision falls back to its rule or refuses, and
// says which — see `src/labplanner/planning/decisions/`.
if (flag('--answers')) packetArgs.push('--answers', flag('--answers'));
if (flag('--label-prefix')) packetArgs.push('--label-prefix', flag('--label-prefix'));
// WHICH CONSTRUCTS, AND HOW FAR. Both are about SCOPE OF ISSUE and neither changes the
// experiment: `--only` says whose workbook this is, `--phase` says how much of it is being handed
// over now. Nothing on the sheet moves because of them — the same construct compiles to the same
// rows whether it is alone in a book or one of four. → `planning/sequences/clone-and-characterize.js`
if (flag('--only')) packetArgs.push('--only', flag('--only'));
if (flag('--phase')) packetArgs.push('--phase', flag('--phase'));

// **A REFUSAL IS AN ANSWER, NOT AN EXCEPTION.** `c6-packet` exits 2 when it will not hand over a
// packet — every file in a dialect it cannot read, or a problem that makes the sheets
// untrustworthy — and it has already said why on stderr, which is inherited. Letting `execFileSync`
// throw printed a Node stack trace over the top of that explanation.
//
// This repository has made the same mistake once before, one layer down: *"c6-plan exits 1 on any
// finding, so `execFileSync` threw and one finding killed the compile."*
const packet = (() => {
  try {
    return execFileSync('node', packetArgs, { encoding: 'utf8', maxBuffer: 64e6,
                                              stdio: ['ignore', 'pipe', 'inherit'] });
  } catch (e) {
    console.error('\n  c6-labplan: no workbook was written — see above.');
    process.exit(typeof e.status === 'number' ? e.status : 2);
  }
})();
const tmp = path.join(fs.mkdtempSync('/tmp/c6-labplan-'), 'packet.json');
fs.writeFileSync(tmp, packet);

const parsed = JSON.parse(packet);
console.error(`  ${parsed.sheets.length} session(s):`);
for (const s of parsed.sheets) console.error(`   ${String(s.metadata.session).padStart(2)}. ${s.operation}`);

// EVERY DECISION THE COMPILER REFUSED TO MAKE, IN ONE PLACE. A labsheet showing a hole is right;
// a person having to read nine sheets to find the holes is not.
// FROM THE SHEET'S OWN LIST, not from grepping its prose. `models/labsheet.js` keeps open
// decisions in `open`, so this reads a field instead of matching a prefix that a rewording would
// silently break. Notes are still searched, for a packet.json written before the spine landed.
const open = parsed.sheets.flatMap((s) => [
  ...(s.open || []).map((o) => `STILL TO DECIDE: ${o}`),
  ...(s.notes || []).filter((n) => n.startsWith('STILL TO DECIDE:'))]
  .filter(Boolean)
  .map((n) => `session ${s.metadata.session} (${s.operation}): ${n.slice(16).trim()}`));
if (open.length) {
  console.error('');
  console.error(`  ${open.length} decision(s) this compiler will not make for you:`);
  for (const o of open) console.error(`   - ${o}`);
}

// **A PCR SHEET THAT CANNOT SAY THE PROGRAM IS NOT WRITTEN.** JCA, 2026-09-16, reading a sheet whose
// size column said `not computed` and whose program column said `follows from the size`:
//
// > *"That means the construction file is invalid. Either there is an error in the CF or in the
// > simulator and it should be resolved somehow rather than return labsheets."*
//
// The gate is HERE and not in the planner, because the planner's job is to compile honestly and
// three decisions already on the record depend on it doing so — a PCR whose primers nobody has
// chosen yet, a file robbed of every size by one absent template, and the STILL TO DECIDE channel
// that already carries an unknown length. → `planning/planExperiment.js § FATAL`
//
// What must not happen is the ARTEFACT: a printed page telling somebody to run a reaction without
// saying how. That happens at the moment the workbook is written, so it is refused at that moment.
// Everything before it still works — `--packet-out` hands over the packet, `c6-decide` lists what
// is open, and `--answers` closes it.
//
// **OPEN DECISIONS IN GENERAL ARE NOT A GATE**, and must not become one: the tube prefix is open on
// every experiment that has not been answered, so refusing on any open decision would refuse every
// workbook this toolkit has ever made.
const noProgram = parsed.sheets.flatMap((s) => (s.samples || [])
  .filter((r) => Object.prototype.hasOwnProperty.call(r, 'program') && !String(r.program || '').trim()
                 || String(r.program || '') === 'follows from the size')
  .map((r) => `session ${s.metadata.session}: ${r.label || r.construct} — `
            + `${String(r['expected size'] || 'no size')}`));
if (noProgram.length && !packetOut) {
  console.error('');
  console.error(`  ${noProgram.length} PCR(s) have no thermocycler program, so no workbook was `
              + 'written:');
  for (const o of noProgram) console.error(`   - ${o}`);
  console.error('');
  console.error('  The program is computed from the simulated product length, so a sheet without '
              + 'one tells somebody to run a reaction and cannot say how. Either the construction '
              + 'file names a primer that does not match, or the template\u2019s sequence is not in '
              + 'the project. `c6-sim <file> --project <dir>` says which.');
  console.error('  `--packet-out <file>` still gives you the packet to look at.');
  process.exit(3);
}

if (packetOut) {
  fs.writeFileSync(packetOut, packet);
  console.error('');
  console.error(`  wrote ${packetOut} — the packet, before any lab-specific injection.`);
  process.exit(0);
}

const py = process.env.PYTHON || '/opt/homebrew/opt/python@3.12/bin/python3.12';
const render = [path.join(HERE, '..', 'src', 'labplanner', 'render', 'labpacket-to-xlsx.py'),
                tmp, out];
if (collector) render.push('--collector', collector);
for (const pass of ['--sequencing-url']) if (flag(pass)) render.push(pass, flag(pass));
console.error('');
execFileSync(py, render, { stdio: ['ignore', 'inherit', 'inherit'] });
