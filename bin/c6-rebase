#!/usr/bin/env node
// bin/c6-rebase — refresh src/data/rebase-enzymes.json from REBASE.
//
//     c6-rebase            download and rewrite the data file
//     c6-rebase --check    report drift, change nothing (exit 1 if any)
//
// WHY A DOWNLOADER AND NOT A TRANSCRIPTION. JCA, 2026-09-17, on the buffer table: *"The deal is
// NEB keeps changing their buffers."* A file somebody typed out once answers that by rotting
// quietly. REBASE is Roberts' database at NEB, reissued every month with a version number, and
// `msbuffmoretabs.txt` is a tab-delimited table built to be parsed. So the recognition sequence,
// the cut offsets, the methylation sensitivity and the supplied buffer come from there and are
// refreshed by running this — none of them is retyped.
//
// WHAT REBASE DOES NOT HAVE, measured 2026-09-17 and not assumed: the string `%` appears ZERO
// times in all three msbuff files. REBASE gives the ONE buffer each supplier ships an enzyme in.
// It does not give percent activity in the other three NEBuffers, which is the actual question —
// *"we need to know what all the good ones are for a given enzyme"* — nor star-activity flags,
// incubation temperatures, or NEB's HF/v2 product names (0 matches for `HF`). That layer is in
// src/C6-Buffers.js, hand-kept from NEB's performance chart, and it is the ONLY hand-kept part.
//
// The cut5/cut3 convention here is the one C6-Sim.js already uses — EcoRI -5/-1, BsaI 1/5,
// BseRI 10/8 — because C6's own table was derived from REBASE in the first place. That is why
// they can be joined on the enzyme name without a mapping.
import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';

const HERE = path.dirname(fileURLToPath(import.meta.url));
const OUT = path.join(HERE, '..', 'src', 'data', 'rebase-enzymes.json');
const SRC = 'ftp://ftp.neb.com/pub/rebase/msbuffmoretabs.txt';
const VERSION_SRC = 'ftp://ftp.neb.com/pub/rebase/staract.txt';

/** REBASE stamps its release number in the header of the prose files, not in the tabbed ones. */
async function rebaseVersion(text) {
  const m = text.match(/REBASE version (\d+)/);
  return m ? m[1] : null;
}

function parse(text) {
  const lines = text.split('\n');
  const rows = {};
  for (const line of lines.slice(1)) {
    const f = line.split('\t');
    if (f.length < 8 || !f[0].trim()) continue;
    const [name, site, cut5, cut3, meth, type, suppliers, buffers] = f;
    // A SUPPLIER'S BUFFER, KEYED BY SUPPLIER LETTER. "N:NEBuffer r3.1,R:Promega E" — N is NEB.
    // Keeping the whole map rather than only N means a bench with Promega stock is answerable.
    const supplied = {};
    for (const part of (buffers || '').split(',')) {
      const i = part.indexOf(':');
      if (i > 0) supplied[part.slice(0, i).trim()] = part.slice(i + 1).trim();
    }
    // METHYLATION IS A MAP, NOT A SENTENCE. "Dam:blocked,CpG:cut" — and an EMPTY map means REBASE
    // lists nothing, which is NOT the same as "no enzyme is blocked". Callers must not read {} as
    // a clean bill of health, so the field is absent rather than empty when nothing was listed.
    const methylation = {};
    for (const part of (meth || '').split(',')) {
      const i = part.indexOf(':');
      if (i > 0 && part.slice(i + 1).trim() !== '-') {
        methylation[part.slice(0, i).trim()] = part.slice(i + 1).trim();
      }
    }
    rows[name.trim()] = {
      site: site.trim(),
      cut5: Number(cut5),
      cut3: Number(cut3),
      type: (type || '').trim(),
      suppliers: (suppliers || '').trim(),
      ...(Object.keys(methylation).length ? { methylation } : {}),
      ...(Object.keys(supplied).length ? { supplied } : {}),
    };
  }
  return rows;
}

async function fetchText(url) {
  // Node's fetch does not speak ftp; curl does, and it is what the download was proven with.
  const { execFileSync } = await import('child_process');
  return execFileSync('curl', ['-sS', '-m', '60', url], { maxBuffer: 1 << 26 }).toString();
}

const check = process.argv.includes('--check');
const raw = await fetchText(SRC);
if (!raw.startsWith('enzyme name\t')) {
  console.error(`c6-rebase: ${SRC} did not return the tabbed table — refusing to write.`);
  process.exit(2);
}
const enzymes = parse(raw);
const version = await rebaseVersion(await fetchText(VERSION_SRC));
const doc = {
  source: SRC,
  rebaseVersion: version,
  retrieved: new Date(Date.now() - new Date().getTimezoneOffset() * 60000).toISOString().slice(0, 10),
  count: Object.keys(enzymes).length,
  note: 'GENERATED by bin/c6-rebase. Do not edit. REBASE has no percent-activity data — the '
      + 'cross-buffer activity matrix lives in src/C6-Buffers.js and is hand-kept from NEB’s '
      + 'performance chart.',
  enzymes,
};
// ONE ENZYME PER LINE. Pretty-printing 1482 records cost 210 KB of mostly indentation; a single
// line cost 60 KB and is unreadable. A line per enzyme is small AND gives a month-to-month refresh
// a diff somebody can actually read — which is the point of refreshing it at all.
const body = Object.keys(doc.enzymes).sort()
  .map((k) => ` ${JSON.stringify(k)}: ${JSON.stringify(doc.enzymes[k])}`).join(',\n');
const head = Object.entries(doc).filter(([k]) => k !== 'enzymes')
  .map(([k, v]) => ` ${JSON.stringify(k)}: ${JSON.stringify(v)}`).join(',\n');
const text = `{\n${head},\n "enzymes": {\n${body}\n }\n}\n`;

if (check) {
  const have = fs.existsSync(OUT) ? JSON.parse(fs.readFileSync(OUT, 'utf8')) : null;
  if (!have) { console.error('c6-rebase --check: src/data/rebase-enzymes.json is missing'); process.exit(1); }
  // COMPARE CANONICALLY. The stored file is written key-sorted; REBASE serves its own order
  // (Acc113I before Acc16I), so a plain stringify of the two reported DRIFT on byte-identical
  // data — a check that cries wolf every run is a check nobody reads.
  const canon = (o) => JSON.stringify(Object.keys(o).sort().map((k) => [k, o[k]]));
  const a = canon(have.enzymes), b = canon(doc.enzymes);
  if (a !== b) {
    console.error(`c6-rebase --check: DRIFT — stored REBASE ${have.rebaseVersion} `
                + `(${have.count} enzymes) differs from live ${version} (${doc.count}). Run c6-rebase.`);
    process.exit(1);
  }
  console.log(`ok     rebase-enzymes.json matches REBASE ${version} — ${doc.count} enzymes`);
  process.exit(0);
}
fs.writeFileSync(OUT, text);
console.log(`wrote  src/data/rebase-enzymes.json — REBASE ${version}, ${doc.count} enzymes, `
          + `${(text.length / 1024).toFixed(0)} KB`);
