#!/usr/bin/env node
// bin/c6-plan — which labsheets does this project need, and what goes on each?
//
//     c6-plan <dir>            every construction file in the tree
//     c6-plan <file> [<file>]  just these
//     c6-plan <dir> --json
//     c6-plan <dir> --inventory <file.tsv>     ...and resolve the oligos against the freezer
//     c6-plan <files> --project <dir>          where to resolve sequences from (default: their
//                                              common ancestor)
//
// STAGE ONE OF THE PLANNER, AND THE ONLY STAGE THAT IS EXACT. JCA, 2026-09-10: *"First step: bin
// like reactions… Figure out any dependencies between samples… this is also something you should
// be able to do precisely with code looking at input/output relationships of steps."*
//
// It answers what the labsheets ARE. What goes ON them — tubes or strips or a plate, how many
// colonies, which freezer well — is per-operation judgement and lives in
// src/labplanner/planning/operations/ as instructions rather than code.
//
// POINTING THIS AT A WHOLE PROJECT IS AN EXERCISE, NOT A PLAN. JCA, 2026-09-10: *"It is fine
// that you are running *all* the construction files through this as an excercise, but these
// experiments weren't intended to be run altogether. At some point testing like this will be
// problematic most likely, but at least it allows you to determine if things get binned
// properly."* Ten construction files written over a year bin into eight labsheets, and that
// output is a good test of the binning and a thing nobody would ever run. The real input is the
// handful of construction files somebody means to do together, and `c6-plan <file> <file>` is
// how you say which.
//
// EXIT CODES: 0 planned · 1 planned with problems · 2 could not run.
import fs from 'fs';
import path from 'path';
import { extractJobsFromCFs } from '../src/labplanner/planning/cfToJobs.js';
import { binReactions, describe } from '../src/labplanner/planning/binReactions.js';
import { planDilutions, describe as describeDilutions } from '../src/labplanner/planning/planDilutions.js';
import { ensureInventory } from '../src/inventory/io.js';
import { projectSequences } from '../src/labplanner/planning/projectSequences.js';
import { annotatePCRProductSizes } from '../src/labplanner/planning/pcrProductSize.js';
import { annotatePCRPrograms } from '../src/labplanner/planning/choosePCRProgram.js';
import { attachMastermixPlans } from '../src/labplanner/planning/makeMastermixPlan.js';
import { injectGelJobs } from '../src/labplanner/planning/injectGel.js';
import { injectCleanupJobs } from '../src/labplanner/planning/injectCleanup.js';
import { applyTransformRecoveryNotes } from '../src/labplanner/planning/injectTransformRecovery.js';

const argv = process.argv.slice(2);
const asJson = argv.includes('--json');
const invArg = (() => { const i = argv.indexOf('--inventory'); return i >= 0 ? argv[i + 1] : null; })();
const targets = argv.filter((a, i) => !a.startsWith('--')
  && argv[i - 1] !== '--inventory' && argv[i - 1] !== '--project');
if (!targets.length) { console.error('  c6-plan: give a directory or construction files'); process.exit(2); }

// A project's plan is both files. Auto-discovered rather than passed explicitly, and
// symmetric with construction files on purpose: requiring one to be named while the other is
// found is the inconsistency somebody trips on, and a stray file changing a plan is already
// true of construction files. JCA left the call here; this is it.
const isCF   = (f) => /construction.*\.txt$/i.test(path.basename(f));
const isChar = (f) => /characteri[sz]ation.*\.txt$/i.test(path.basename(f));
function collect(p, out = []) {
  const st = fs.existsSync(p) && fs.statSync(p);
  if (!st) return out;
  if (st.isDirectory()) {
    for (const e of fs.readdirSync(p)) {
      if (e.startsWith('.') || e === 'node_modules') continue;
      collect(path.join(p, e), out);
    }
  } else if (isCF(p) || isChar(p) || targets.includes(p)) out.push(p);
  return out;
}

const files = [...new Set(targets.flatMap((t) => collect(t)))].sort();
if (!files.length) { console.error('  c6-plan: no construction files found'); process.exit(2); }

const cfs = files.map((f) => ({ name: path.basename(f, '.txt').replace(/^(Construction|Characteri[sz]ation) of /i, ''),
                                characterization: isChar(f),
                                text: fs.readFileSync(f, 'utf8') }));
const lifted = extractJobsFromCFs(cfs);

// SEQUENCES RESOLVE FROM THE WHOLE PROJECT, NOT FROM THE FOLDER YOU ASKED ABOUT.
//
// A construction file's inputs live wherever they were made: planning SLIP2 and SLIP3 together
// needs `pGhost12-A`, which is in SLIP3, and `pGhost4`, which is elsewhere again. Taking the
// first target as the root made every PCR in that run report "no product size" — a true
// statement about a search that was looking in one folder.
//
// So the root is the common ancestor of everything named, and `--project` overrides it.
function commonAncestor(paths) {
  const parts = paths.map((p) => path.resolve(p).split(path.sep));
  const out = [];
  for (let i = 0; i < Math.min(...parts.map((p) => p.length)); i++) {
    const seg = parts[0][i];
    if (parts.every((p) => p[i] === seg)) out.push(seg); else break;
  }
  const joined = out.join(path.sep) || path.sep;
  // A single file's ancestor is the file itself; walk up to its directory.
  return fs.existsSync(joined) && fs.statSync(joined).isDirectory() ? joined : path.dirname(joined);
}
const projArg = (() => { const i = argv.indexOf('--project'); return i >= 0 ? argv[i + 1] : null; })();
const root = projArg || commonAncestor(targets);
let sequences = null;
try { sequences = root ? projectSequences(root) : null; } catch { sequences = null; }
annotatePCRProductSizes(lifted.jobs, { cfs, sequences });
annotatePCRPrograms(lifted.jobs, { sequences });

applyTransformRecoveryNotes(lifted.jobs);

const binned = binReactions(lifted);
// The steps a construction file does not contain and a labsheet must. Order-independent: each
// injected bin carries a fractional depth and the list is re-sorted.
binned.sheets = injectCleanupJobs(injectGelJobs(binned.sheets));
attachMastermixPlans(binned.sheets, {});
const problems = [...lifted.problems, ...binned.cycles];

let dilutions = null;
if (invArg) {
  if (!fs.existsSync(invArg)) { console.error(`  c6-plan: no inventory at ${invArg}`); process.exit(2); }
  const inv = ensureInventory(fs.readFileSync(invArg, 'utf8'), path.basename(invArg));
  dilutions = planDilutions(lifted.jobs, inv);
  if (dilutions.error) problems.push({ code: 'INVENTORY_UNREADABLE', cf: invArg, line: 0,
                                       message: dilutions.error });
}

if (asJson) {
  console.log(JSON.stringify({
    files, problems, dilutions,
    sheets: binned.sheets.map((s) => ({
      index: s.index, operation: s.operation, round: s.round, rounds: s.rounds, cfs: s.cfs,
      mastermix: s.mastermixPlan || null,
      samples: s.jobs.map((j) => ({ output: j.output, cf: j.cf, line: j.line,
                                    inputs: j.dnaInputs, oligos: j.oligos,
                                    productBp: j.productBp ?? null, program: j.program ?? null,
                                    chemistry: j.chemistry ?? null, note: j.programNote || null,
                                    approximate: !!j.approximate })),
    })),
  }, null, 2));
} else {
  // SAY WHICH KIND, because they are different documents about different phases and a count
  // that calls a characterization file a construction file is the sort of small dishonesty
  // that makes somebody look in the wrong place later.
  const nChar = cfs.filter((c) => c.characterization).length;
  const nCF = cfs.length - nChar;
  const what = [nCF && `${nCF} construction file(s)`, nChar && `${nChar} characterization file(s)`]
    .filter(Boolean).join(' + ');
  console.log(`  ${what}, ${lifted.jobs.length} step(s) `
            + `-> ${binned.sheets.length} labsheet(s)`);
  console.log(`  sequences from ${root} `
            + `(${sequences ? Object.keys(sequences.oligos).length + ' oligos, '
                + Object.keys(sequences.plasmids).length + ' plasmids' : 'NONE — sizes unavailable'})\n`);
  console.log(describe(binned));

  for (const s2 of binned.sheets.filter((x) => x.operation === 'pcr')) {
    console.log(`\n  PCR labsheet ${s2.index + 1}:`);
    for (const j of s2.jobs) {
      console.log(`     ${j.output.padEnd(10)} ${String(j.productBp ?? '?').padStart(6)} bp  `
                + `${(j.program || '—').padEnd(9)} ${(j.chemistry || '').padEnd(10)}`
                + `${j.programNote ? '  ' + j.programNote.slice(0, 70) : ''}`);
    }
    for (const g of (s2.setup ? s2.setup.groups : [])) {
      const p = g.plan;
      const head = s2.setup.groups.length > 1 ? `   [${g.chemistry || 'unspecified'}] ` : '     ';
      console.log(`${head}${p.why}`);
      if (p.mastermix) {
        console.log(`     mastermix: ${p.shared.map((c) => `${c.key} ${c.totalUL} uL`).join(', ')}`);
        console.log(`     per tube : ${p.perTube.map((c) => c.key).join(', ') || '(nothing)'}`);
      }
    }
    if (s2.setup && s2.setup.considerSplitting) console.log(`     ${s2.setup.considerSplitting}`);
    for (const u of (s2.setup ? s2.setup.unresolved : []))
      console.log(`     ${u.output}: no setup planned — ${String(u.why).slice(0, 90)}`);
  }

  for (const g of binned.sheets.filter((x) => x.operation === 'gel' && x.unknownSizes)) {
    console.log(`\n  Gel labsheet ${g.index + 1}: ${g.unknownSizes} of ${g.lanes.length} lane(s) `
              + 'have no expected size. Say so on the sheet — a blank column reads as '
              + '"no band expected".');
  }

  const transforms = lifted.jobs.filter((j) => j.operation === 'transform');
  if (transforms.length) {
    console.log('\n  transformations:');
    for (const t of transforms) {
      const ctl = t.controls && t.controls.length
        ? `+ ${t.controls.length} controls (${t.controls[0].what.match(/\b[KSECA]1\b/) || ''})` : '';
      console.log(`     ${t.output.padEnd(10)} ${String(t.antibiotic || '?').padEnd(6)} `
                + `${t.rescue === null ? 'rescue UNKNOWN' : t.rescue ? 'needs rescue  ' : 'no rescue     '} ${ctl}`);
      if (t.transformNote) console.log(`                ${t.transformNote.slice(0, 88)}`);
    }
  }
  // Oligos are what the dilution stage needs first; naming them here makes the next stage's
  // input visible before that stage exists.
  const oligos = [...new Set(lifted.jobs.flatMap((j) => j.oligos))].sort();
  const approx = lifted.jobs.filter((j) => j.approximate).length;
  if (dilutions) {
    console.log(`\n  oligos, against ${path.basename(invArg)}:`);
    console.log(describeDilutions(dilutions));
  } else {
    console.log(`\n  ${oligos.length} oligo(s) to resolve against an inventory `
              + `(pass --inventory to do it): ${oligos.join(', ') || '(none)'}`);
  }
  if (approx) console.log(`  ${approx} step(s) were read approximately — their oligos could not be `
                        + `told from their templates, so that list is incomplete.`);
  if (problems.length) {
    console.log(`\n  ${problems.length} problem(s):`);
    for (const p of problems) console.log(`     ${p.code.padEnd(32)} ${p.cf}:${p.line} ${p.message || p.output}`);
  }
}
process.exit(problems.length ? 1 : 0);
