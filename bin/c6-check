#!/usr/bin/env node
// bin/c6-check — check every construction file in a project folder.
//
//     c6-check <dir>            report findings, human-readable
//     c6-check <dir> --json     the same as JSON
//     c6-check <file>           one file
//
// WHY A BIN ENTRY. C6's checks are useless until something runs them over a project, which is
// exactly the gap this was built to close: on 2026-09-10 the parser rejected a SynThera
// construction file outright, and had done so for as long as the file existed, because nobody
// had ever pointed it at the repository. A library nobody invokes reports nothing, and a repo
// with a latent defect and a repo with none look identical from outside.
//
// It is also the first entry in `bin/`, which is the directory a C11 sharable's `entry`
// resolves against — so this doubles as the seam that lets an executive reach C6's capabilities
// without knowing where C6 is installed.
//
// EXIT CODES: 0 clean · 1 findings · 2 could not run (bad path, unreadable directory).
// Findings exit non-zero on purpose, so this can sit in a pre-commit hook or CI.

import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';
import { validateConstructionFile } from '../src/labplanner/validate/constructionFile.js';

// STDOUT BELONGS TO THIS TOOL. `parseCF` writes a debug line ("parseCF returning CF") on every
// call, which is harmless when a human is reading and fatal when a machine is: `--json` emitted
// valid JSON with a stray word in front of it, so every consumer got a parse error. Found
// 2026-09-10 by Cortex's `labindex` trying to read this tool and silently concluding the
// toolkit was not installed — absence collapsing into a plausible wrong answer, one layer out.
//
// Suppressed here rather than removed from the library: other callers may rely on that output,
// and a tool defending its own stdout is correct regardless of what its dependencies do.
const _log = console.log;
const _silence = () => { console.log = () => {}; };
const _restore = () => { console.log = _log; };

const HERE = path.dirname(fileURLToPath(import.meta.url));

// A construction file is recognised by name, because that is how they are actually named in
// every project on this machine: "Construction of pGhost17.txt", "Construction of lParB5
// lib.txt". `.cf` is accepted too. Recognising by CONTENT would be better and is a later job —
// stated here rather than pretended past.
const LOOKS_LIKE_CF = (f) => /^construction\b.*\.txt$/i.test(f) || /\.cf$/i.test(f);

const SKIP_DIRS = new Set(['.git', 'node_modules', 'site', 'dist', '.venv', '__pycache__']);

// HISTORICAL EXPERIMENTS ARE DESCRIBED, NOT NAGGED ABOUT.
//
// JCA, 2026-09-10, on a construction file whose plan provably could not have produced what the
// freezer holds: *"I think you want to leave those records alone. They are historical... it's
// very possible that this is the empirically-derived map, not the simulated product. It's what
// we actually isolated and moved forward with."*
//
// A finished experiment's record is not corrected even where the plan is demonstrably wrong:
// the file says what was PLANNED, the sequenced map beside it says what was OBTAINED, and
// editing the first to match the second destroys the only evidence they ever differed.
//
// So a checker that exits non-zero on those files forever is a nag about work nobody should do
// — the badgering failure, arriving in a new domain. An experiment marks itself finished by
// holding a HISTORICAL file (any content; the presence is the statement). Findings there are
// still REPORTED, because going silent would hide the record from somebody reading it fresh —
// they simply stop counting toward the exit code.
const HISTORICAL_MARKER = 'HISTORICAL';

function historicalRoots(dir, found = new Set()) {
  let entries;
  try {
    entries = fs.readdirSync(dir, { withFileTypes: true });
  } catch {
    return found;
  }
  if (entries.some((e) => e.isFile() && e.name === HISTORICAL_MARKER)) found.add(dir);
  for (const e of entries) {
    if (e.isDirectory() && !SKIP_DIRS.has(e.name) && !e.name.startsWith('.')) {
      historicalRoots(path.join(dir, e.name), found);
    }
  }
  return found;
}

function isHistorical(file, roots) {
  for (const r of roots) if (file.startsWith(r + path.sep)) return true;
  return false;
}

function walk(dir, out = []) {
  let entries;
  try {
    entries = fs.readdirSync(dir, { withFileTypes: true });
  } catch {
    return out;               // unreadable subdirectory: skipped, not fatal
  }
  for (const e of entries) {
    if (e.name.startsWith('.') && e.name !== '.') continue;
    const full = path.join(dir, e.name);
    if (e.isDirectory()) {
      if (!SKIP_DIRS.has(e.name)) walk(full, out);
    } else if (LOOKS_LIKE_CF(e.name)) {
      out.push(full);
    }
  }
  return out;
}

function main() {
  const args = process.argv.slice(2);
  const asJson = args.includes('--json');
  const target = args.find((a) => !a.startsWith('--'));

  if (!target) {
    console.error('usage: c6-check <dir|file> [--json]');
    return 2;
  }
  let stat;
  try {
    stat = fs.statSync(target);
  } catch {
    console.error(`c6-check: no such path: ${target}`);
    return 2;
  }

  const files = stat.isDirectory() ? walk(target) : [target];
  const results = files.map((f) => {
    const rel = path.relative(target, f) || path.basename(f);
    let text;
    try {
      text = fs.readFileSync(f, 'utf8');
    } catch (err) {
      // Unreadable is a finding, never a silent skip — a file that could not be checked and a
      // file with nothing wrong must not print the same thing.
      return { file: rel, ok: false, parsed: false, steps: 0, findings: [{
        code: 'UNREADABLE', level: 'error', step: null,
        message: `could not read: ${err.message}`,
      }] };
    }
    _silence();
    try {
      return { file: rel, ...validateConstructionFile(text, rel) };
    } finally {
      _restore();
    }
  });

  const roots = stat.isDirectory() ? historicalRoots(target) : new Set();
  for (const r of results) r.historical = isHistorical(path.join(target, r.file), roots);

  // Findings in a finished experiment are described and not counted. `bad` drives the exit
  // code; `withFindings` drives what is printed.
  const withFindings = results.filter((r) => !r.ok);
  const bad = withFindings.filter((r) => !r.historical);

  if (asJson) {
    console.log(JSON.stringify({ target, checked: results.length, results }, null, 2));
    return bad.length ? 1 : 0;
  }

  if (!files.length) {
    // Not a pass. Zero files checked is a fact about the search, not about the project.
    console.log(`  no construction files found under ${target}`);
    console.log('  (recognised by name: "Construction*.txt" or "*.cf")');
    return 0;
  }

  for (const r of results) {
    if (r.ok) {
      console.log(`  ok    ${r.file}  (${r.steps} step${r.steps === 1 ? '' : 's'})`);
    } else {
      console.log(`  ${r.historical ? 'note' : 'FAIL'}  ${r.file}`
                  + (r.historical ? '   (historical — described, not counted)' : ''));
      for (const f of r.findings) {
        console.log(`          ${f.code}${f.step ? ` [step ${f.step}]` : ''}`);
        console.log(`          ${f.message}`);
      }
    }
  }
  const hist = withFindings.filter((r) => r.historical).length;
  console.log(`\n  ${results.length} checked · ${bad.length} with findings`
              + (hist ? ` · ${hist} in historical experiments, described not counted` : ''));
  return bad.length ? 1 : 0;
}

process.exit(main());
