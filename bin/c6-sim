#!/usr/bin/env node
// bin/c6-sim — simulate a construction file, resolving its inputs across a whole project.
//
//     c6-sim <file.txt> --project <dir>                   simulate; print every product
//     c6-sim <file.txt> --project <dir> --json            the same, as JSON
//     c6-sim <file.txt> --project <dir> --primes <oligo>  ...and say where that oligo anneals
//     c6-sim <file.txt> --project <dir> --maps                compare each product with its recorded map
//
// WHY A BIN ENTRY, AND WHY IT RESOLVES THE PROJECT ITSELF. `c6-check` reads a construction
// file's STRUCTURE — unknown operations, dangling products, inputs used before they are made.
// It deliberately never asks whether the chemistry works, and cannot: that needs sequences, and
// sequences are scattered across the project in four different kinds of file. So every time
// somebody wanted to know whether a PCR actually produces its product, they wrote the resolver
// again by hand. It was written twice in one day before it became this.
//
// `--primes` answers the question that follows every simulated PCR and has no other tool: the
// sequencing primer for this construct — does it actually sit inside the thing we made, which
// way does it read, and is there only one place it could bind? A primer with two sites gives an
// unreadable trace, and nothing about the construction file would ever tell you.
//
// EXIT CODES: 0 simulated · 1 a step failed, or --maps found a product that differs from its
// recorded map · 2 could not run.
import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';
import { parseCF, simCF, simRestrictionEnzymes } from '../src/C6-Sim.js';
import { compareToMap } from '../src/labplanner/validate/mapMatch.js';
import { LINES } from '../src/C6-Utils.js';
import { projectSequences, preambleFor } from '../src/labplanner/planning/projectSequences.js';
import { attachPools } from '../src/library/readPool.js';
import { hasSlots, lengthRange, screenBinsForSite, occupancyCount } from '../src/library/slots.js';

// stdout belongs to this tool — parseCF narrates. Same reason as c6-check.
const _log = console.log, silence = () => { console.log = () => {}; }, restore = () => { console.log = _log; };
const HERE = path.dirname(fileURLToPath(import.meta.url));

const argv = process.argv.slice(2);
const arg = (n) => { const i = argv.indexOf(n); return i >= 0 && i + 1 < argv.length ? argv[i + 1] : null; };
const file = argv.find((a) => !a.startsWith('--') && argv[argv.indexOf(a) - 1] !== '--project'
                              && argv[argv.indexOf(a) - 1] !== '--primes');
const asJson = argv.includes('--json');
const project = arg('--project') || (file ? path.dirname(file) : null);
const primes = arg('--primes');

if (!file || !fs.existsSync(file)) { console.error('  c6-sim: give a construction file'); process.exit(2); }
if (!project || !fs.existsSync(project)) { console.error('  c6-sim: --project must be a directory'); process.exit(2); }

const RC = (s) => s.toUpperCase().split('').reverse()
  .map((c) => ({ A: 'T', T: 'A', G: 'C', C: 'G' }[c] || 'N')).join('');

const cfText = fs.readFileSync(file, 'utf8');
const seqs = projectSequences(project);
const pre = preambleFor(cfText, seqs);

// WHICH NAMES DID NOT RESOLVE. Reported before simulating, because "a step failed" and "an
// input was never found" are different problems and the second explains the first.
const defined = new Set([...Object.keys(seqs.oligos), ...Object.keys(seqs.plasmids)]);
const produced = new Set();
const wanted = new Set();
// Names that stand in an ENZYME position, which is a fact about the step's grammar rather than a
// guess from the shape of the word. `GoldenGate` puts the enzyme second from the end
// (C6-Sim.js:265) and `Digest` puts a comma-separated list in field 2 (C6-Sim.js:282).
const enzymesNamed = new Set();
for (const line of cfText.split(LINES)) {
  const c = line.split('\t').map((s) => s.trim()).filter(Boolean);
  if (c.length < 2 || /^(oligo|plasmid|dsdna)$/i.test(c[0])) continue;
  if (/^(GoldenGate|Assemble)$/i.test(c[0]) && c.length >= 4) enzymesNamed.add(c[c.length - 2]);
  if (/^Digest$/i.test(c[0]) && c[2]) for (const e of c[2].split(',')) enzymesNamed.add(e.trim());
  if (/^(PCR|Gibson|GoldenGate|Assemble|Digest|Ligate)$/i.test(c[0])) {
    produced.add(c[c.length - 1]);
    for (const x of c.slice(1, -1)) wanted.add(x);
  }
  // `Transform <dna> <strain> <antibiotic> <product>` — only the first input is DNA. Listing a
  // strain as a missing sequence is a false finding, and false findings are what stop people
  // reading the real ones.
  if (/^Transform$/i.test(c[0])) { produced.add(c[c.length - 1]); if (c[1]) wanted.add(c[1]); }
}
// **AN ENZYME IS NOT A SEQUENCE THAT IS MISSING.** This exempted four enzyme names written out
// by hand — BsaI, BsmBI, BbsI, SapI — so `GoldenGate pTlib1 pP6 BseRI pExTP_gg` reported
// "missing: BseRI" although BseRI has been in the simulator's table all along, and AarI would
// have read the same. A hand-copied list of what the simulator knows is a second source for one
// fact, and it was already wrong. Ask the table itself.
const KNOWN_ENZYME = new Set(Object.keys(simRestrictionEnzymes));
const missing = [...wanted].filter((n) => !defined.has(n) && !produced.has(n)
  && !enzymesNamed.has(n)
  && !/^(Mach1|JTK\d+|DH5|Amp|Spec|Kan|Cam|[A-Z]{2,4}\s?[AB]{1,2})$/i.test(n));
// An enzyme the file names and the simulator does NOT know is a different finding from a
// sequence that is missing, and they are reported apart because they are fixed in different
// places: one by adding a file to the project, the other by adding a row to
// `simRestrictionEnzymes`. Reported here rather than left to the step that throws, because the
// throw is about the FIRST such enzyme and stops the simulation, while this lists them all.
const unknownEnzymes = [...enzymesNamed].filter((n) => !KNOWN_ENZYME.has(n));

let result = { file, project, products: [], failed: null, missing, unknownEnzymes };
try {
  silence();
  // A pool arrives through the preamble as a plain sequence; this is what makes it a library
  // again before anything simulates it. Without it every guard in library/slots.js is inert.
  const out = simCF(attachPools(parseCF(pre ? pre + '\n' + cfText : cfText), seqs.pools));
  restore();
  for (const [name, val] of out) {
    const s = String(val && val.sequence != null ? val.sequence : val).toUpperCase();
    const rec = { name, bp: s.length, sequence: s };
    // **A POOL'S SIZE IS A RANGE, AND `bp` ALONE IS A MEAN PRESENTED AS A FACT.** The skeleton
    // carries an N-run at each slot's average span, so `sequence.length` for a library is a
    // plausible wrong number — right for almost no member. Reporting it bare is exactly the
    // failure `lengthRange`'s `bound` field exists to prevent, and this is the one place a person
    // actually reads the number.
    if (hasSlots(val)) {
      const r = lengthRange(val);
      rec.range = { min: r.min, max: r.max, bound: r.bound };
      rec.members = occupancyCount(val.occupancy, val.slots);
      // A COMBINATORIAL PRODUCT IS NOT A MEMBER LIST, and saying which it is changes what a reader
      // does next: 180 rows can be picked from a plate, 48 combinations have to be sampled.
      rec.combinatorial = !!(val.occupancy && val.occupancy.kind === 'product');
      rec.slots = val.slots.map((x) => x.name);
      rec.poly = val;   // kept so --primes can search the bins rather than only the skeleton
    }
    result.products.push(rec);
  }
} catch (e) { restore(); result.failed = String(e.message || e).split('\n')[0]; }

// WHY A PCR FAILED, WHICH IS USUALLY NOT "THE PLAN IS WRONG".
//
// `simCF` requires the 3'-most 18 bases of a primer to match the template EXACTLY (C6-Sim.js:389
// and :407). That is a sound simplification for ordinary primers and it rules out a whole class
// of real ones: a primer carrying an engineered point mutation — silently killing a restriction
// site, say — has to put that mutation where the site is, and if the site falls within 18 bases
// of the 3' end the primer can never satisfy the rule. It still primes perfectly well at the
// bench, which is why SynThera's pGhost17 exists in the freezer and cannot be simulated.
//
// So on failure, measure each primer's longest 3'-anchored exact match and say which side of
// the 18 it falls. "Failed" alone sends somebody to fix a construction file that is correct.
if (result.failed && /anneal/i.test(result.failed)) {
  const longest = (oligo, template) => {
    const d = (template + template).toUpperCase(); let best = 0;
    for (let k = 8; k <= oligo.length; k++) {
      if (d.indexOf(oligo.toUpperCase().slice(-k)) < 0 && d.indexOf(RC(oligo.slice(-k))) < 0) break;
      best = k;
    }
    return best;
  };
  result.anneal = [];
  for (const line of cfText.split(LINES)) {
    const c = line.split('\t').map((s) => s.trim()).filter(Boolean);
    if (!/^PCR$/i.test(c[0] || '')) continue;
    const tpl = seqs.plasmids[c[3]] || seqs.oligos[c[3]];
    if (!tpl) continue;
    for (const n of [c[1], c[2]]) {
      const o = seqs.oligos[n]; if (!o) continue;
      const m = longest(o, tpl);
      result.anneal.push({ oligo: n, template: c[3], exact3: m, nt: o.length, ok: m >= 18 });
    }
  }
}

// --maps: DOES THE SIMULATED PRODUCT MATCH THE MAP SOMEBODY RECORDED FOR IT?
//
// This is the question the record has advertised all along — `sharables/cf.sim.json` carries the
// phrase "does the simulated plasmid match the recorded map" — and the tool could not answer it:
// `--json` stripped the product sequences before anything could look at them, so the only way to
// compare was to re-simulate by hand and diff in an editor. A length in the output is not an
// answer either: pP6 simulates to 3555 bp and `Maps/pP6.seq` is 3555 bp, and equal lengths say
// nothing about whether it is the same DNA.
//
// THREE OUTCOMES, AND THE THIRD IS NOT THE FIRST. `no map` means nobody recorded one, which is
// not agreement and must never be printed or counted as agreement — the whole value of this
// check is that "we verified it" and "there was nothing to verify against" stay apart.
const MAP_FILE = /\.(seq|gb|gbk|ape)$/i;

/** Where `name` was read from, if it was read from a plasmid map file at all. */
function mapSourceFor(name) {
  if (!seqs.plasmids[name]) return null;
  for (const s of seqs.sources[name] || []) {
    const file = String(s).replace(/\s*\([^)]*\)\s*$/, '').trim();
    if (MAP_FILE.test(file)) return file;
  }
  return null;
}

if (argv.includes('--maps')) {
  result.maps = result.products.map((p) => {
    const where = mapSourceFor(p.name);
    if (!where) return { product: p.name, bp: p.bp, status: 'no map' };
    // A library has an N-run where its slots are, so it cannot be compared base for base against
    // anything. Saying "differs" about that would be a false finding.
    if (p.range) return { product: p.name, status: 'no map', map: where,
                          note: 'this product is a library; its skeleton carries N and cannot be compared to a map' };
    return { product: p.name, bp: p.bp, map: where, map_bp: seqs.plasmids[p.name].length,
             ...compareToMap(p.sequence, seqs.plasmids[p.name]) };
  });
}

if (primes) {
  const p = seqs.oligos[primes] || seqs.plasmids[primes];
  if (!p) result.primes = { oligo: primes, error: 'no sequence for that name in the project' };
  else {
    const site = (seq, q) => { const out = []; let i = -1;
      while ((i = seq.indexOf(q, i + 1)) >= 0) out.push(i + 1); return out; };
    result.primes = { oligo: primes, length: p.length, in: result.products.map((pr) => ({
      product: pr.name, bp: pr.bp,
      forward: site(pr.sequence, p.toUpperCase()),
      reverse: site(pr.sequence, RC(p)),
    })) };
  }
}

if (asJson) {
  console.log(JSON.stringify({ ...result, products: result.products.map(({ sequence, ...r }) => r) }, null, 2));
} else {
  console.log(`  ${path.basename(file)}  (project ${path.basename(project)})`);
  if (missing.length) console.log(`  ${missing.length} input(s) with no sequence anywhere in the project: ${missing.join(', ')}`);
  if (unknownEnzymes.length) console.log(`  unknown enzyme ${unknownEnzymes.join(', ')} — not in C6's table, so no step using it can be simulated. Add it to simRestrictionEnzymes in src/C6-Sim.js.`);
  if (result.failed) {
    console.log(`  SIMULATION FAILED: ${result.failed}`);
    for (const a of result.anneal || []) {
      console.log(`     ${a.oligo.padEnd(10)} ${String(a.nt).padStart(3)} nt  `
        + `3'-anchored exact match ${String(a.exact3).padStart(3)} nt on ${a.template}`
        + (a.ok ? '' : `   <- under C6's 18 nt rule; an engineered base sits ${a.exact3 + 1} nt from the 3' end`));
    }
    if ((result.anneal || []).some((a) => !a.ok))
      console.log('     A primer can fail this rule and still work at the bench. Check whether\n'
                + '     the short match is a DESIGNED mutation before treating this as a defect.');
  }
  for (const p of result.products) {
    if (!p.range) { console.log(`     ${p.name.padEnd(14)} ${String(p.bp).padStart(6)} bp`); continue; }
    // `~` marks an outer bound: for a sparse library the extremes of each slot need not co-occur
    // in any real member, so this contains the true range rather than being it.
    const approx = p.range.bound === 'outer' ? '~' : ' ';
    const span = `${p.range.min}-${p.range.max}`;
    const who = p.members != null
      ? `${p.members}${p.combinatorial ? ' combinations' : ' members'}`
      : 'membership unknown';
    console.log(`     ${p.name.padEnd(14)} ${approx}${span.padStart(5)} bp   library: ${who}` +
                `, variable: ${p.slots.join(', ')}`);
  }
  if (result.maps) {
    console.log('\n  against the recorded maps:');
    for (const m of result.maps) {
      if (m.status === 'no map') {
        // "No map" is printed in full every time, never collapsed into silence: a product with
        // nothing to check against is a gap in the record, and a check that quietly skips it
        // reads afterwards as a check that passed.
        console.log(`     ${m.product.padEnd(14)} no map in the project${m.note ? ` (${m.note})` : ''}`);
      } else if (m.status === 'match') {
        console.log(`     ${m.product.padEnd(14)} match      ${m.bp} bp, ${m.orientation} as ${m.map}`);
      } else {
        const d = m.first_difference;
        console.log(`     ${m.product.padEnd(14)} DIFFERS    simulated ${m.bp} bp vs ${m.map_bp} bp in ${m.map}`
          + ` (${m.delta > 0 ? '+' : ''}${m.delta} bp)`
          + (d ? `\n     ${''.padEnd(14)} first difference at base ${d.at}: simulated ${d.simulated}, map ${d.map}`
               : `\n     ${''.padEnd(14)} ${m.note}`));
      }
    }
  }
  if (result.primes) {
    const r = result.primes;
    if (r.error) console.log(`  ${r.oligo}: ${r.error}`);
    else {
      console.log(`\n  ${r.oligo} (${r.length} nt) as a primer:`);
      for (const h of r.in) {
        const f = h.forward.length, v = h.reverse.length;
        const where = !f && !v ? 'NOT PRESENT'
          : `${f ? `forward at ${h.forward.join(', ')}` : ''}${f && v ? '; ' : ''}${v ? `reverse at ${h.reverse.join(', ')}` : ''}`;
        // MORE THAN ONE SITE IS THE FINDING. A primer that binds twice gives an unreadable
        // trace, and no structural check of the construction file can see it.
        const warn = f + v > 1 ? '   ** more than one site — the read will be unusable **' : '';

        // **ON A LIBRARY THIS COUNT IS A FLOOR, NOT A COUNT**, and saying so matters more here
        // than anywhere else in this tool. Sites are found against the SKELETON, whose slots hold
        // N and match nothing — so a primer that binds inside a variable region reads as NOT
        // PRESENT, and one that binds a second time in some members only reads as binding once.
        // "Binds exactly once" is the entire question `--primes` exists to answer, and for a pool
        // the skeleton cannot answer it.
        const lib = result.products.find((x) => x.name === h.product && x.range);
        const size = lib ? `${lib.range.bound === 'outer' ? '~' : ''}${lib.range.min}-${lib.range.max}`
                         : String(h.bp);
        let extra = '';
        if (lib) {
          // The skeleton count above is a floor. The BINS are the rest of the answer, so search
          // them rather than merely disclaiming them: a primer site hiding in a variable region is
          // the same defect as a restriction site hiding there, and the same screen finds it.
          const site = String(r.sequence || '').toUpperCase();
          const found = site ? screenBinsForSite(lib.poly, [site, RC(site)]) : [];
          const unscreenable = found.filter((x) => x.unscreenable);
          const hits = found.filter((x) => !x.unscreenable);
          if (hits.length) {
            const n = hits.reduce((a, x) => a + x.members.length, 0);
            extra = `\n     ${''.padEnd(14)}          ** ALSO binds inside `
                  + hits.map((x) => `"${x.slot}" in ${x.members.length}/${x.total} members`).join(', ')
                  + ` — ${n} member(s) get a second site and an unusable read **`;
          } else if (unscreenable.length) {
            extra = `\n     ${''.padEnd(14)}          variable `
                  + unscreenable.map((x) => `"${x.slot}"`).join(', ')
                  + ` has no declared bin, so this count is a FLOOR, not a count`;
          } else {
            extra = `\n     ${''.padEnd(14)}          ${lib.members ?? '?'} members, and no member`
                  + ` carries this site inside ${lib.slots.map((x) => `"${x}"`).join(' or ')}`;
          }
        }
        console.log(`     ${h.product.padEnd(14)} ${size.padStart(6)} bp   ${where}${warn}${extra}`);
      }
    }
  }
}
// EXIT NON-ZERO ON A DIFFERENCE, because a product that does not match its recorded map is a
// finding somebody has to act on, and a check nothing can fail is not a check.
process.exit(result.failed || (result.maps || []).some((m) => m.status === 'differs') ? 1 : 0);
