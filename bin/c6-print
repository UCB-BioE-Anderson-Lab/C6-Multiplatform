#!/usr/bin/env python3
# bin/c6-print — render a markdown bench sheet as a page you can read and print.
#
#     c6-print <file.md>            write <file>.html beside it and open it
#     c6-print <file.md> --no-open  just write it
#
# WHY THIS EXISTS. A compiled labsheet is a workbook because a workbook is what gets printed and
# carried to a bench. Some experiments are better explained in prose than in a grid — JCA,
# 2026-10-21: *"You are finding this experiment to be better explained in an md format. And I
# guess there is nothing really wrong with that ... One drawback is I can't just open it and have
# it be rendered."* That drawback is the whole reason a markdown sheet loses to a spreadsheet in
# practice, and it is a tooling problem rather than a format one.
#
# NO NEW DEPENDENCY IF IT CAN BE HELPED. Uses `markdown` when it is importable and falls back to
# a small converter that handles the things a bench sheet actually uses — headings, tables,
# fenced code, blockquotes, lists, bold and italic. The fallback is not a general markdown
# implementation and does not pretend to be; it is there so the command still works on a machine
# that has nothing installed, which is the machine this was written for.
#
# PRINT IS THE TARGET, not the screen. Tables get borders and repeat their header across a page
# break, a heading never prints as the last line of a page, and the checkbox and blank-cell
# conventions a bench sheet uses stay visible in black and white.
import os
import re
import subprocess
import sys

CSS = """
@page { margin: 14mm 12mm; }
body { font: 10.5pt/1.45 -apple-system, "Helvetica Neue", Arial, sans-serif;
       max-width: 46em; margin: 2em auto; padding: 0 1em; color: #111; }
h1 { font-size: 19pt; border-bottom: 2px solid #111; padding-bottom: .2em; }
h2 { font-size: 14pt; margin-top: 1.6em; border-bottom: 1px solid #999; padding-bottom: .15em; }
h3 { font-size: 11.5pt; margin-top: 1.2em; }
h1, h2, h3 { break-after: avoid-page; page-break-after: avoid; }
table { border-collapse: collapse; width: 100%; margin: .8em 0; font-size: 9.5pt; }
th, td { border: 1px solid #555; padding: 4px 6px; text-align: left; vertical-align: top; }
th { background: #eee; font-weight: 600; }
thead { display: table-header-group; }      /* repeat the header on every printed page */
tr { break-inside: avoid-page; page-break-inside: avoid; }
/* AN EMPTY CELL IS SOMETHING TO WRITE IN, so it must not collapse to nothing on paper. */
td:empty { height: 1.6em; background: repeating-linear-gradient(
             90deg, transparent, transparent 3px, #f4f4f4 3px, #f4f4f4 6px); }
blockquote { border-left: 4px solid #c00; background: #fff6f6; margin: 1em 0;
             padding: .5em .9em; break-inside: avoid-page; }
blockquote strong { color: #900; }
code { font: 9.5pt/1.3 "SF Mono", Menlo, monospace; background: #f3f3f3; padding: 1px 3px; }
pre { background: #f3f3f3; border: 1px solid #ddd; padding: .6em .8em; overflow-x: auto;
      break-inside: avoid-page; }
pre code { background: none; padding: 0; }
hr { border: 0; border-top: 1px solid #ccc; margin: 1.6em 0; }
@media print { body { margin: 0; max-width: none; } a { color: #111; text-decoration: none; } }
"""


def convert(text):
    """Markdown to HTML, with the library if it is there and a small fallback if not."""
    try:
        import markdown  # noqa: WPS433
        return markdown.markdown(text, extensions=["tables", "fenced_code", "sane_lists"])
    except ImportError:
        return _fallback(text)


def _fallback(text):
    # DELIBERATELY SMALL. It covers what a bench sheet uses and nothing else; anything it does not
    # understand passes through as a paragraph rather than being mangled into something that looks
    # converted. A half-rendered sheet is worse than an obviously plain one.
    out, lines, i = [], text.split("\n"), 0
    while i < len(lines):
        line = lines[i]
        if line.startswith("```"):
            block = []
            i += 1
            while i < len(lines) and not lines[i].startswith("```"):
                block.append(_esc(lines[i]))
                i += 1
            out.append("<pre><code>" + "\n".join(block) + "</code></pre>")
        elif re.match(r"^\|.*\|\s*$", line) and i + 1 < len(lines) and re.match(r"^\|[\s:|-]+\|\s*$", lines[i + 1]):
            head = _cells(line)
            i += 2
            body = []
            while i < len(lines) and re.match(r"^\|.*\|\s*$", lines[i]):
                body.append(_cells(lines[i]))
                i += 1
            i -= 1
            out.append("<table><thead><tr>" + "".join(f"<th>{_inline(c)}</th>" for c in head)
                       + "</tr></thead><tbody>"
                       + "".join("<tr>" + "".join(f"<td>{_inline(c)}</td>" for c in r) + "</tr>" for r in body)
                       + "</tbody></table>")
        elif re.match(r"^#{1,6} ", line):
            n = len(line) - len(line.lstrip("#"))
            out.append(f"<h{n}>{_inline(line[n:].strip())}</h{n}>")
        elif line.startswith(">"):
            quote = []
            while i < len(lines) and lines[i].startswith(">"):
                quote.append(lines[i].lstrip("> ").rstrip())
                i += 1
            i -= 1
            out.append("<blockquote>" + _inline(" ".join(quote)) + "</blockquote>")
        elif re.match(r"^\s*[-*] ", line):
            items = []
            while i < len(lines) and re.match(r"^\s*[-*] ", lines[i]):
                items.append(_inline(re.sub(r"^\s*[-*] ", "", lines[i])))
                i += 1
            i -= 1
            out.append("<ul>" + "".join(f"<li>{x}</li>" for x in items) + "</ul>")
        elif re.match(r"^---+\s*$", line):
            out.append("<hr>")
        elif line.strip():
            para = []
            while i < len(lines) and lines[i].strip() and not re.match(r"^[#>|`-]", lines[i]):
                para.append(lines[i].strip())
                i += 1
            i -= 1
            out.append("<p>" + _inline(" ".join(para)) + "</p>")
        i += 1
    return "\n".join(out)


def _cells(row):
    return [c.strip() for c in row.strip().strip("|").split("|")]


def _esc(s):
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def _inline(s):
    s = _esc(s)
    s = re.sub(r"`([^`]+)`", r"<code>\1</code>", s)
    s = re.sub(r"\*\*([^*]+)\*\*", r"<strong>\1</strong>", s)
    s = re.sub(r"(?<!\*)\*([^*]+)\*(?!\*)", r"<em>\1</em>", s)
    s = re.sub(r"\[([^\]]+)\]\(([^)]+)\)", r'<a href="\2">\1</a>', s)
    return s


def main(argv):
    args = [a for a in argv if not a.startswith("--")]
    if not args:
        print("  c6-print: give a markdown file", file=sys.stderr)
        print("    c6-print <file.md> [--no-open]", file=sys.stderr)
        return 2
    src = args[0]
    if not os.path.exists(src):
        print(f"  c6-print: no such file: {src}", file=sys.stderr)
        return 2
    text = open(src, encoding="utf-8").read()
    title = next((l.lstrip("# ").strip() for l in text.split("\n") if l.startswith("# ")),
                 os.path.basename(src))
    html = (f"<!doctype html><html><head><meta charset='utf-8'><title>{_esc(title)}</title>"
            f"<style>{CSS}</style></head><body>{convert(text)}</body></html>")
    dst = os.path.splitext(src)[0] + ".html"
    open(dst, "w", encoding="utf-8").write(html)
    print(f"  wrote {dst}")
    if "--no-open" not in argv:
        subprocess.run(["open", dst], check=False)
        print("  opened — Cmd+P to print, or save as PDF from the print dialog")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
