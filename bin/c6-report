#!/usr/bin/env node
// bin/c6-report — every claim the toolkit makes about its own behaviour, with the evidence, as one
// page somebody answers true or false to.
//
//     c6-report                say what it would write
//     c6-report --write        regenerate docs/REPORT.html
//     c6-report --open <dir>   also leave the generated experiment folders there, to compile by hand
//
// **THE FIRST VERSION OF THIS PAGE WAS UNREVIEWABLE AND THE REASON IS WORTH KEEPING.** It printed
// twenty-eight compiled experiments and fifteen broken ones and let the reader work out which parts
// were assertions. JCA, 2026-09-16:
//
// > *"It's kinda an incomprehensible babble of facts. I really don't know how to review it. You need
// > to start over with it and express it as a series of claims questions that I can answer
// > true/false to."*
//
// **A page of evidence with no claim in it cannot be disagreed with.** The reader has to invent the
// question before they can answer it, and inventing the question is the expensive half — which is
// exactly the work a review is supposed to save. So the unit here is a CLAIM: one sentence in domain
// terms, the evidence for it underneath, and two radio buttons.
//
// The claims are in `src/labplanner/scenarios/claims.js`. This file runs them and draws them.
//
// ## Everything on the page was produced by running something
//
// No sentence here is transcribed from a test or from memory. Each claim names a scenario or a
// fault; the scenario is generated as a real project folder, compiled by `bin/c6-packet`, and the
// evidence is pulled out of the packet that came back. A claim whose wording has drifted from what
// the toolkit does is therefore visible ON the page, sitting above a table that contradicts it.
//
// ## What the answers are for
//
// FALSE is the useful answer. It means the toolkit does something a person who knows the chemistry
// would not do, and that is a defect no test can find — every test in this repository asserts that
// a number did not change, and none of them knows whether `pS-A` is the right thing to write on a
// tube. The page ends with a button that copies the answers as text to paste back.
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import { spawnSync } from 'node:child_process';
import { fileURLToPath } from 'node:url';
import { everyScenario, scenario } from '../src/labplanner/scenarios/scenarios.js';
import { writeScenario } from '../src/labplanner/scenarios/generate.js';
import { FAULTS, fault, FAULT_SEQUENCES } from '../src/labplanner/scenarios/faults.js';
import { CLAIMS, groups } from '../src/labplanner/scenarios/claims.js';
import { coverage } from '../src/labplanner/scenarios/coverage.js';

const HERE = path.dirname(fileURLToPath(import.meta.url));
const ROOT = path.join(HERE, '..');
const OUT = path.join(ROOT, 'docs', 'REPORT.html');
const argv = process.argv.slice(2);
const keepAt = argv.includes('--open') ? argv[argv.indexOf('--open') + 1] : null;

const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

/**
 * Run a bin command over a folder and keep BOTH streams, on success as well as on failure.
 *
 * `execFileSync` returns stdout and discards stderr when a command SUCCEEDS, and that is where every
 * finding in this toolkit lives — a compile that carries on and reports is the ordinary case. An
 * earlier draft of this page showed nothing for five faults because of it, each of which was
 * reporting correctly all along. On failure it discarded stderr a second way, preferring
 * `e.message` — `Command failed: node /Users/…` — printing a path where the sentence should be.
 */
function run(cmd, dir) {
  const args = [path.join(ROOT, 'bin', cmd), dir];
  for (const [file, flag] of [['inventory.txt', '--inventory'], ['answers.json', '--answers']]) {
    if (fs.existsSync(path.join(dir, file))) args.push(flag, path.join(dir, file));
  }
  const r = spawnSync('node', args, { encoding: 'utf8', maxBuffer: 64e6 });
  return { ok: r.status === 0, out: String(r.stdout || ''), err: String(r.stderr || '') };
}

/** Everything a run said to a person, from whichever stream it used, minus its own preamble. */
const said = (r) => [r.err, r.out.trimStart().startsWith('{') ? '' : r.out].join('\n')
  .split('\n')
  .filter((l) => l.trim() && !/labelPrefix ".." — taken from the folder name/.test(l))
  .join('\n').trim();

// ── running the examples once each ───────────────────────────────────────────────────────────────

const tmp = keepAt || fs.mkdtempSync(path.join(os.tmpdir(), 'c6-report-'));
fs.mkdirSync(tmp, { recursive: true });

const ran = new Map();
function evidenceFor(from) {
  const key = from.fault ? `fault:${from.fault}` : `scenario:${from.scenario}`;
  if (ran.has(key)) return ran.get(key);
  let dir;
  if (from.fault) {
    const f = fault(from.fault);
    dir = path.join(tmp, `fault-${f.id}`);
    fs.mkdirSync(dir, { recursive: true });
    // THE SEQUENCES GO IN FIRST AND THE BROKEN FILES OVER THEM, so a fault that deliberately names
    // its own sequences wins. → `faults.js § FAULT_SEQUENCES`
    for (const [n, t] of Object.entries({ ...FAULT_SEQUENCES, ...f.files })) {
      fs.writeFileSync(path.join(dir, n), t);
    }
  } else {
    dir = writeScenario(scenario(from.scenario), tmp);
  }
  const packet = run('c6-packet', dir);
  const check = from.fault ? run('c6-check', dir) : null;
  const got = {
    dir,
    files: Object.fromEntries(fs.readdirSync(dir)
      .filter((n) => /\.(txt|json|tsv)$/.test(n) && n !== 'answers.json')
      .map((n) => [n, fs.readFileSync(path.join(dir, n), 'utf8')])),
    packet: packet.ok ? JSON.parse(packet.out) : null,
    message: [check && said(check) ? `$ c6-check\n${said(check)}` : '',
              said(packet) ? `$ c6-packet\n${said(packet)}` : ''].filter(Boolean).join('\n\n'),
  };
  ran.set(key, got);
  return got;
}

// ── drawing one claim ────────────────────────────────────────────────────────────────────────────

// THE CAPTION SITS OUTSIDE THE TABLE. A `<table>` here is `display:block` so that a wide one can
// scroll sideways, and a `<caption>` inside that inherits the table's width — so a three-column
// table wrapped its own title into a narrow ragged column. The title is about the table, not part
// of it.
const table = (t) => `<p class="cap">${esc(t.caption)}</p><table><tr>`
  + t.cols.map((c) => `<th>${esc(c)}</th>`).join('') + '</tr>'
  + t.rows.map((r) => `<tr>${r.map((c) => `<td>${esc(c) || '<span class=e>·</span>'}</td>`).join('')}</tr>`).join('')
  + '</table>'
  + (t.more ? `<p class="more">…and ${t.more} more row(s)</p>` : '');

function evidenceHtml(c, got) {
  if (c.show === 'message') {
    return got.message
      ? `<pre class="msg">${esc(got.message)}</pre>`
      : '<p class="none">nothing was said by either command.</p>';
  }
  if (!got.packet) return `<pre class="msg">${esc(got.message)}</pre>`;
  const e = c.show(got.packet);
  if (!e) return '<p class="none">the evidence this claim points at is not in the packet.</p>';
  if (e.lines) {
    return `<p class="cap">${esc(e.caption)}</p><ul class="notes">`
         + e.lines.map((l) => `<li>${esc(l)}</li>`).join('') + '</ul>';
  }
  return table(e);
}

function claimHtml(c, n) {
  const got = evidenceFor(c.from);
  const src = c.from.fault ? `fault <code>${esc(c.from.fault)}</code>`
                           : `scenario <code>${esc(c.from.scenario)}</code>`;
  const inputs = Object.entries(got.files)
    .map(([nm, t]) => `<h6>${esc(nm)}</h6><pre>${esc(t.trim())}</pre>`).join('');
  return `
<section class="claim" id="${esc(c.id)}">
  <div class="head"><span class="n">${n}</span>
    <p class="says">${esc(c.claim)}</p></div>
  ${c.why ? `<p class="why">${esc(c.why)}</p>` : ''}
  <div class="ev">${evidenceHtml(c, got)}</div>
  <div class="ask">
    <label><input type="radio" name="q${n}" value="T"> true</label>
    <label><input type="radio" name="q${n}" value="F"> false</label>
    <input class="note" data-n="${n}" placeholder="…because">
    <span class="from">${src}</span>
  </div>
  <details><summary>the files this was run on</summary>${inputs}</details>
</section>`;
}

/**
 * What this page does NOT ask about — measured, not estimated.
 *
 * JCA: *"How complete are we though? … Or is it impossible to anticipate all scenarios?"* Both, and
 * the section separates them. It goes at the END, after the claims, because it is the answer to
 * "what did I just finish reading" rather than an introduction to it. → `scenarios/coverage.js`
 */
const cov = await coverage();
// **THE COUNT IN THE HEADING IS GENERATED FROM THE SAME PREDICATE AS THE LIST UNDER IT.** A first
// draft wrote "Six designs no claim asks about" as words beside a generated list, which is two
// descriptions of one fact, free to disagree the moment somebody adds a claim — the defect this
// repository keeps finding in its own inputs, reintroduced on the page that reports it.
const WORD = ['No', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten'];
const gapList = (xs, pred) => xs.filter(pred).map((x) => `<code>${esc(x.id)}</code>`).join(', ');
const gap = (xs, pred, one, many) => {
  const n = xs.filter(pred).length;
  return `${WORD[n] ?? n} ${n === 1 ? one : many}`;
};
const bar = (c) => {
  const w = (k) => Math.round((c[k] / c.total) * 100);
  return `<div class="bar"><span class="ruled" style="width:${c.ruled ? w('ruled') : 0}%"></span>`
       + `<span class="reach" style="width:${w('reached') - (c.ruled ? w('ruled') : 0)}%"></span></div>`;
};
const cc = cov.counts;
const coverageHtml = `<h2>How much of this did anybody look at</h2>
<div class="how">
<p><strong>Scenarios are unbounded; decisions are not.</strong> Nobody can list the experiments a lab
will write. But every one of them is compiled by a countable set of decisions, and that set can be
listed and watched. So "have we covered every scenario?" has no answer, and "which decisions has
nobody looked at?" does.</p>
<p>Two different things, and the second is what this page is for:
<span class="key"><span class="sw reach"></span>a run took this path</span>
<span class="key"><span class="sw ruled"></span>a claim above asserts something about it, and you
answered</span>. The suite gives the first. Only you give the second.</p>
</div>
<table class="cov">
<tr><th></th><th>in the toolkit</th><th>a run reaches</th><th>a claim asks about</th></tr>
<tr><td>rules in the rule tables</td><td>${cc.rules.total}</td><td>${cc.rules.reached}${bar(cc.rules)}</td><td class="na">not measurable — see below</td></tr>
<tr><td>design modules</td><td>${cc.designs.total}</td><td>${cc.designs.reached}${bar(cc.designs)}</td><td>${cc.designs.ruled}</td></tr>
<tr><td>problem codes</td><td>${cc.codes.total}</td><td>${cc.codes.reached}${bar(cc.codes)}</td><td>${cc.codes.ruled}</td></tr>
</table>
<p class="cap">${CLAIMS.length} claims drawn from ${cov.runs} of the runs in the matrix.</p>

<h3>The gaps, by name</h3>
<dl class="gaps">
<dt>${gap(cov.designs, (d) => d.reached && !d.ruled, 'design', 'designs')} no claim asks about</dt>
<dd>${gapList(cov.designs, (d) => d.reached && !d.ruled)} — every one of them runs in the matrix and
is asserted by unit tests. Nobody has been shown what they put on a page. <strong>This is the
largest gap and it is the one worth closing next.</strong></dd>
<dt>${gap(cov.codes, (c) => c.reached && !c.ruled, 'reported problem', 'reported problems')} no claim asks about</dt>
<dd>${gapList(cov.codes, (c) => c.reached && !c.ruled)} — each fires, and nobody has ruled on whether
the sentence it prints is the right sentence.</dd>
<dt>${gap(cov.codes, (c) => !c.reached, 'problem', 'problems')} nothing reaches</dt>
<dd>${gapList(cov.codes, (c) => !c.reached)} — no example produces either. <code>SESSION_OUTGROWS_VESSEL</code>
became unreachable when <code>allocateWells</code> landed, which is the good outcome; it is named
here rather than deleted, because the day it fires again is the day a compile started colliding.</dd>
<dt>${gap(cov.rules, (r) => !r.reached, 'rule', 'rules')} nothing reaches</dt>
<dd>${gapList(cov.rules, (r) => !r.reached)} — held to exactly this set by
<code>scenarios.test.js</code>, so a third one appearing fails the suite.</dd>
</dl>

<div class="how">
<p><strong>Why "a claim asks about it" is not measurable for rules.</strong> One scenario fires about
forty rules. A claim pinning one sentence of that run has asserted nothing about the other
thirty-nine. An earlier draft of this table counted them all and reported 52 of 54, which looked
excellent and only meant the runs behind the claims are ordinary experiments.</p>
<p><strong>And what none of it can see.</strong> Two kinds of defect, both of which have already
happened here. Correct decisions composing badly — four constructs each picked into well A1, every
rule right, the combination wrong, full coverage on both rules throughout. And a decision that
should exist and does not: your ruling that <em>"not all these controls are needed when transforming
miniprep DNA"</em> was a missing distinction, and no count of what exists will ever find what is
absent. That is what reading the claims does and the numbers cannot.</p>
</div>
`;

// ── the page ─────────────────────────────────────────────────────────────────────────────────────

let n = 0;
const byGroup = groups().map((g) => {
  const body = CLAIMS.filter((c) => c.group === g).map((c) => claimHtml(c, ++n)).join('');
  return `<h2>${esc(g)}</h2>${body}`;
}).join('');

// **A COMMENT WITH BACKTICKS IN IT, INSIDE A TEMPLATE LITERAL, ENDS THE LITERAL.** The note
// explaining the clipboard fix was written with `navigator.clipboard` in backticks and inserted
// into the page's inline <script>, which is itself a backtick string — so the rest of the page
// became JavaScript and `c6-report` stopped loading at all. The reasoning now lives out here,
// where backticks are ordinary.
//
// The clipboard needs a secure context, and this page is opened over file:// or rendered in a
// pane, so the button did nothing and said nothing — worse than not having one. JCA: "your copy
// button didn't work." The answers now go into a textarea ON the page, selected, so copying works
// with the keyboard whatever the browser allows; the clipboard is still attempted, because where
// it works it is one click.
const STYLE = `
/* The coverage table. TWO COLOURS, NOT A PERCENTAGE — the distance between the bars is the point:
   the dark part is what somebody ruled on, the pale part is what merely ran without complaint. */
table.cov { width:100%; border-collapse:collapse; margin:.6rem 0 .2rem; }
table.cov th { text-align:left; font-weight:600; font-size:.82rem; color:#555; padding:.3rem .5rem;
               border-bottom:1px solid #ddd; }
table.cov td { padding:.45rem .5rem; border-bottom:1px solid #eee; vertical-align:top; }
table.cov td.na { color:#888; font-style:italic; }
.bar { height:6px; background:#e8e8e8; border-radius:3px; margin-top:.3rem; overflow:hidden;
       display:flex; width:140px; }
.bar span { display:block; height:100%; }
.ruled { background:#2f6f4f; } .reach { background:#bcd9c8; }
.key { margin-right:1.1rem; white-space:nowrap; }
.sw { display:inline-block; width:.7rem; height:.7rem; border-radius:2px; margin-right:.3rem;
      vertical-align:-1px; }
dl.gaps dt { font-weight:600; margin-top:.8rem; }
dl.gaps dd { margin:.25rem 0 0 0; padding-left:0; color:#333; }

:root{--ink:#1a1a1a;--dim:#666;--line:#e2e2e2;--code:#f6f6f4;--hi:#0b57d0}
*{box-sizing:border-box}body{margin:0;background:#fff;color:var(--ink);
 font:16px/1.6 -apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,sans-serif}
.wrap{max-width:54rem;margin:0 auto;padding:2.5rem 1.5rem 8rem}
h1{font-size:1.7rem;margin:0 0 .5rem}
h2{font-size:1.15rem;margin:3rem 0 .5rem;padding-bottom:.4rem;border-bottom:2px solid var(--ink)}
h6{margin:.8rem 0 .2rem;font-size:.72rem;color:var(--dim);text-transform:uppercase;letter-spacing:.05em}
.lede{color:var(--dim);margin:0 0 1rem}
.how{background:#f4f8ff;border:1px solid #cfe0ff;border-radius:4px;padding:1rem 1.2rem;margin:1.5rem 0}
.how p{margin:.4rem 0}
.claim{border:1px solid var(--line);border-radius:4px;padding:1rem 1.2rem;margin:1.1rem 0}
.head{display:flex;gap:.8rem;align-items:baseline}
.n{flex:none;width:2rem;height:2rem;line-height:2rem;text-align:center;border-radius:50%;
 background:var(--ink);color:#fff;font-size:.85rem;font-weight:600}
.says{margin:0;font-size:1.02rem}
.why{color:var(--dim);font-size:.87rem;margin:.5rem 0 0 2.8rem;padding-left:.6rem;
 border-left:2px solid var(--line)}
.ev{margin:.9rem 0 .6rem 2.8rem}
table{border-collapse:collapse;font-size:13px;margin:.2rem 0;display:block;overflow-x:auto;max-width:100%}
th,td{border:1px solid var(--line);padding:.28rem .55rem;text-align:left;white-space:nowrap}
th{background:var(--code);font-weight:600}.e{color:#bbb}
pre{background:var(--code);padding:.6rem .8rem;border-radius:3px;overflow-x:auto;
 font:12.5px/1.55 ui-monospace,SFMono-Regular,Menlo,monospace;white-space:pre-wrap;margin:.3rem 0}
pre.msg{background:#fff6f5;border-left:3px solid #e57373}
code{background:var(--code);padding:.05rem .3rem;border-radius:2px;font:12.5px ui-monospace,Menlo,monospace}
.notes{font-size:.9rem;margin:.2rem 0;padding-left:1.1rem}.notes li{margin:.2rem 0}
.cap{color:var(--dim);font-size:.78rem;text-transform:uppercase;letter-spacing:.04em;margin:.2rem 0}
.none{color:#b71c1c;font-size:.9rem;margin:.2rem 0}
.more{color:var(--dim);font-size:.82rem;margin:.2rem 0}
.ask{margin:.8rem 0 0 2.8rem;display:flex;gap:1rem;align-items:center;flex-wrap:wrap}
.ask label{font-size:.95rem;cursor:pointer;padding:.15rem .6rem;border:1px solid var(--line);
 border-radius:3px}
.ask input[type=radio]{margin-right:.35rem}
.note{flex:1;min-width:14rem;border:1px solid var(--line);border-radius:3px;padding:.3rem .5rem;
 font:inherit;font-size:.9rem}
.from{color:var(--dim);font-size:.78rem}
details{margin:.6rem 0 0 2.8rem}summary{cursor:pointer;font-size:.82rem;color:var(--dim)}
#bar{position:fixed;left:0;right:0;bottom:0;background:var(--ink);color:#fff;padding:.7rem 1.5rem;
 display:flex;gap:1rem;align-items:center;font-size:.9rem}
#bar button{font:inherit;padding:.35rem .9rem;border:0;border-radius:3px;background:#fff;
 color:var(--ink);cursor:pointer;font-weight:600}
#tally{opacity:.85}
#out{position:fixed;left:0;right:0;bottom:3.1rem;background:#fff;border-top:1px solid var(--line);
 padding:.8rem 1.5rem;box-shadow:0 -8px 24px rgba(0,0,0,.08)}
#out p{margin:0 0 .4rem;font-size:.85rem;color:var(--dim)}
#text{width:100%;font:12.5px/1.5 ui-monospace,Menlo,monospace;border:1px solid var(--line);
 border-radius:3px;padding:.5rem}
`;

const page = `<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>LabPlanner — ${n} claims to answer</title>
<style>${STYLE}</style></head><body><div class="wrap">

<h1>${n} claims about what LabPlanner does</h1>
<p class="lede">Generated by <code>bin/c6-report --write</code> on
${new Date().toISOString().slice(0, 10)}. Every table and message below came out of a real run made
while building this page — nothing is transcribed.</p>

<div class="how">
<p><strong>Each numbered sentence is a claim about what the toolkit does at a bench.</strong> The
evidence for it is underneath. Answer <em>true</em> if that is what should happen, <em>false</em> if
a person who knows the chemistry would do it differently.</p>
<p><strong>False is the useful answer.</strong> 792 tests pass; every one of them asserts that a
number did not change, and not one knows whether <code>pS-A</code> is the right thing to write on a
tube. That is the only question this page asks.</p>
<p>The button at the bottom puts your answers in a box to copy. Or just say the numbers.</p>
</div>

${byGroup}

${coverageHtml}

</div>
<div id="bar"><button onclick="showAnswers()">Show my answers</button>
<span id="tally">nothing answered yet</span></div>
<div id="out" hidden><p>Select all and copy. (The clipboard is tried too, where the browser allows it.)</p>
<textarea id="text" rows="12" spellcheck="false"></textarea></div>
<script>
function collect(){
  const out=[];
  document.querySelectorAll('.claim').forEach((s,i)=>{
    const n=i+1;
    const picked=document.querySelector('input[name="q'+n+'"]:checked');
    const note=document.querySelector('.note[data-n="'+n+'"]').value.trim();
    if(picked||note) out.push({n,v:picked?picked.value:'?',
      id:s.id,claim:s.querySelector('.says').textContent.trim(),note});
  });
  return out;
}
function tally(){
  const a=collect(), f=a.filter(x=>x.v==='F').length;
  document.getElementById('tally').textContent =
    a.length? a.length+' answered · '+f+' false' : 'nothing answered yet';
}
document.addEventListener('input',tally);
function showAnswers(){
  const a=collect();
  const text=a.length? a.map(x=>x.n+'. '+(x.v==='T'?'TRUE ':'FALSE')+'  '+x.id
    +(x.note?'  — '+x.note:'')+'\\n     '+x.claim).join('\\n\\n')
    : 'nothing answered yet';
  const box=document.getElementById('out'), ta=document.getElementById('text');
  box.hidden=false; ta.value=text; ta.focus(); ta.select();
  try{ navigator.clipboard.writeText(text).then(
    ()=>{document.getElementById('tally').textContent='copied '+a.length+' — or select the box';},
    ()=>{}); }catch(e){}
}

</script></body></html>`;

if (!argv.includes('--write')) {
  console.log(`  would write ${path.relative(process.cwd(), OUT)} — ${n} claims`);
  process.exit(0);
}
fs.writeFileSync(OUT, page);
console.log(`  wrote ${path.relative(process.cwd(), OUT)}`);
console.log(`  ${n} claims over ${groups().length} groups, from ${ran.size} runs`);
const blank = CLAIMS.filter((c) => {
  const got = ran.get(c.from.fault ? `fault:${c.from.fault}` : `scenario:${c.from.scenario}`);
  return c.show !== 'message' && got.packet && !c.show(got.packet);
});
// A CLAIM WHOSE EVIDENCE IS MISSING IS A CLAIM NOBODY CAN JUDGE, and it renders as a red line on
// the page rather than as an empty space. Said here too, because the person regenerating is the
// person who can fix it.
if (blank.length) console.log(`  ${blank.length} claim(s) have NO evidence: `
  + blank.map((c) => c.id).join(', '));
if (keepAt) console.log(`  folders left in ${keepAt}`);
