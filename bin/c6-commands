#!/usr/bin/env node
// bin/c6-commands — the command table of docs/LABPLANNER-API.md § 3.2, generated from bin/.
//
//     c6-commands              print the table
//     c6-commands --write      rewrite § 3.2 between its markers
//     c6-commands --check      report drift, change nothing (exit 1 if any)
//
// **GENERATION IS THE HOUSE PATTERN AND THE HAND-WRITTEN TABLE IS THE FAILURE IT FIXES.** Cortex
// Operations 16, 2026-09-16, asked which way C6 should document its CLI surface:
//
// > *"Cortex's convention is unambiguous and it is generation: `howto/INDEX.md` is generated from
// > the runbooks by `bin/howto-index.py --write`, run on every `cortex sync`. Nobody edits it.
// > `sharables/generated/` is generated from JSDoc by `bin/c6-sharables` — your own repo, same
// > rule, drift-checked by `npm test`. `CLAUDE.md` carries the measurement that settled it: its own
// > table of verbs named twelve while the dispatcher had twenty, so eleven verbs were nameable from
// > nowhere in the constitution. The row now refuses to enumerate and points at the generated table
// > instead."*
//
// C6 had the same failure at the same place: § 3.2 named eight commands of twelve, missing
// `c6-issue` and `c6-receive`, which are half the lifecycle. A test was added requiring every
// `bin/c6-*` to appear — which turns a silent gap into a red one and still leaves somebody typing
// the row. This removes the typing.
//
// ## What is generated and what is not, because the difference is the whole point
//
// **The INVENTORY is generated: which commands exist, and which flags each one takes.** That is
// the half a machine can know and the half that drifts — a command added, a flag added, and the
// document quietly stops describing the toolkit.
//
// **The MEANING stays hand-written**, in § 3.3, where what `--only` does to a compile is explained
// by somebody who understands it. Cortex Ops 16 again, and this is the caution worth keeping:
//
// > *"A generated index kills DRIFT, which is the failure that actually happened to us twice. It
// > cannot kill vacuity. `--only` appears in generated § 3.2 is satisfied by a generated line that
// > says nothing. Do not let the check's greenness stand in for a human having read the section."*
//
// So a green `--check` means the table lists everything. It does not mean the table is any good,
// and nothing here can mean that.
//
// ## Where the words come from
//
// The first line of each command's header comment, which is where somebody opening the file reads
// it. Two comment styles exist in `bin/` — a `/** */` block and a run of `//` — and both are read,
// because rewriting nine files to suit a generator is the generator serving itself.
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const HERE = path.dirname(fileURLToPath(import.meta.url));
const ROOT = path.join(HERE, '..');
const DOC = path.join(ROOT, 'docs', 'LABPLANNER-API.md');
const argv = process.argv.slice(2);

/** The markers § 3.2's table sits between. Prose above and below them is nobody's business here. */
const OPEN = '<!-- generated by bin/c6-commands — do not edit between these markers -->';
const CLOSE = '<!-- end generated -->';

/**
 * The header comment of one `bin/` script, as lines, whichever of the two styles it is written in.
 *
 * A `/** *\/` block and a run of `//` carry the same thing in this repository — a title line, a
 * blank, an indented usage block, then the reasoning — and which one a file uses is an accident of
 * who wrote it. Reading only one style would mean editing nine files so that a generator could
 * work, which is the tool serving itself rather than the repository.
 */
function header(src) {
  const jsdoc = src.match(/^#![^\n]*\n\/\*\*\n([\s\S]*?)\n \*\//);
  if (jsdoc) return jsdoc[1].split('\n').map((l) => l.replace(/^ \* ?/, ''));
  const out = [];
  for (const line of src.split('\n').slice(1)) {
    if (!line.startsWith('//')) break;
    out.push(line.replace(/^\/\/ ?/, ''));
  }
  return out;
}

/**
 * What one command is and which flags it takes, read off its own header comment.
 *
 * @param {string} name  the basename, `c6-packet`
 * @returns {{name, what, flags: Array<string>}}
 */
export function describeCommand(name) {
  const src = fs.readFileSync(path.join(ROOT, 'bin', name), 'utf8');
  const lines = header(src);
  // **THE FIRST PARAGRAPH, NOT THE FIRST LINE.** A description long enough to be worth reading
  // wraps, and taking one line of it cut three rows mid-sentence — "It is what a sharable's
  // `entry`" — which reads as a typo rather than as a truncation and is the kind of thing a
  // generated table gets blamed for. Runs to the first blank line, the way the JSDoc convention
  // this repo already uses treats a description.
  const at = lines.findIndex((l) => l.trim());
  const end = lines.findIndex((l, i) => i > at && !l.trim());
  const first = lines.slice(at, end < 0 ? undefined : end).join(' ');
  // `bin/c6-x — what it does`, or just the sentence where a file did not repeat its own name.
  const what = first.replace(/^(bin\/)?c6-[a-z]+\s*[—-]\s*/, '').replace(/\s+/g, ' ').trim();
  // **QUOTED TOKENS, NOT EVERY `--word` IN THE PROSE.** `c6-holds` explains at length that it
  // deliberately has no `--release`, and a looser scan would list a flag that does not exist and
  // then demand it be documented.
  const flags = [...new Set([...src.matchAll(/['"](--[a-z][a-z0-9-]*)['"]/g)].map((m) => m[1]))];
  return { name, what, flags: flags.sort() };
}

/** Every `bin/c6-*`, in the order a directory listing gives them. */
export function everyCommand() {
  return fs.readdirSync(path.join(ROOT, 'bin'))
    .filter((f) => /^c6-[a-z]+$/.test(f)).sort()
    .map(describeCommand);
}

/**
 * The § 3.2 table as markdown, ready to sit between the markers.
 *
 * @returns {string}
 */
export function commandTable() {
  const rows = everyCommand().map((c) =>
    `| \`${c.name}\` | ${c.what} | ${c.flags.length
      ? c.flags.map((f) => `\`${f}\``).join(' ') : '—'} |`);
  return [OPEN,
    '',
    '| command | what it does | flags |',
    '|---|---|---|',
    ...rows,
    '',
    `*${rows.length} commands, generated from the header comment of each \`bin/c6-*\` by `
    + '`bin/c6-commands`. What the flags MEAN is § 3.3, which is written by hand because no '
    + 'generator can know it.*',
    '',
    CLOSE].join('\n');
}

const doc = fs.readFileSync(DOC, 'utf8');
const want = commandTable();

if (argv.includes('--check') || argv.includes('--write')) {
  const at = doc.indexOf(OPEN);
  const to = doc.indexOf(CLOSE);
  if (at < 0 || to < 0) {
    console.error(`  c6-commands: docs/LABPLANNER-API.md carries no generated block. Put\n`
                + `    ${OPEN}\n    ${CLOSE}\n  where § 3.2's table belongs, and run --write.`);
    process.exit(2);
  }
  const have = doc.slice(at, to + CLOSE.length);
  if (argv.includes('--check')) {
    if (have === want) { console.log(`  in sync: ${everyCommand().length} command(s)`); process.exit(0); }
    // WHAT CHANGED, NOT THAT SOMETHING DID. A drift report naming no line is one somebody
    // regenerates without reading, which is how a check stops being one.
    const a = have.split('\n'); const b = want.split('\n');
    const i = a.findIndex((l, n) => l !== b[n]);
    console.error('  c6-commands: § 3.2 differs from bin/.\n'
      + `    doc:  ${JSON.stringify(a[i] ?? '(end)')}\n    bin:  ${JSON.stringify(b[i] ?? '(end)')}\n`
      + '  Run `node bin/c6-commands --write` — and read the diff first.');
    process.exit(1);
  }
  fs.writeFileSync(DOC, doc.slice(0, at) + want + doc.slice(to + CLOSE.length));
  console.log(`  wrote § 3.2: ${everyCommand().length} command(s)`);
  process.exit(0);
}

console.log(want);
